    function identificarTipoEscala(pessoa) {
        if (pessoa.expedienteSegASex) {
            return 'Expediente (Seg-Sex)';
        }
        
        if (!pessoa.escalaDias || pessoa.escalaDias.length === 0) {
            return 'Sem Escala Fixa';
        }
        
        // Detectar escala base 1-4
        const primeiroDia = Math.min(...pessoa.escalaDias);
        if (primeiroDia >= 1 && primeiroDia <= 4) {
            // Verificar se segue o padrão correto (+4)
            const padrao = pessoa.escalaDias.every((dia, index) => 
                dia === primeiroDia + (index * 4)
            );
            
            if (padrao) {
                return `Escala ${primeiroDia}`;
            }
        }
        
        return 'Escala Personalizada';
    }
    
    function gerarEstatisticasResumo(escalaPorPessoa) {
        const pessoas = Object.values(escalaPorPessoa);
        const totalPessoas = pessoas.length;
        const pessoasSemEscala = pessoas.filter(p => p.totalServicos === 0).length;
        const pessoasNoLimite = pessoas.filter(p => p.totalPontos >= p.limiteServicos).length;
        const pessoasSubutilizadas = pessoas.filter(p => p.totalPontos > 0 && p.totalPontos < p.limiteServicos * 0.3).length;
        
        // Calcular média e distribuição
        const totalServicosGeral = pessoas.reduce((acc, p) => acc + p.totalServicos, 0);
        const mediaServicos = (totalServicosGeral / totalPessoas).toFixed(1);
        
        // Distribuição por turno
        let distribuicaoTurnos = { manha: 0, tarde: 0, noite: 0, integral: 0 };
        pessoas.forEach(p => {
            p.servicos.forEach(s => {
                distribuicaoTurnos[s.turno]++;
            });
        });
        
        return `
            <div style="background: linear-gradient(135deg, #e8eaf6 0%, #c5cae9 100%); 
                      border-radius: 15px; padding: 20px; margin-top: 30px;">
                <h3 style="color: #3f51b5; margin-bottom: 15px;">📊 Estatísticas Gerais</h3>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                    <div style="background: white; padding: 15px; border-radius: 8px; text-align: center;">
                        <div style="font-size: 2em; color: #4caf50; font-weight: bold;">
                            ${totalPessoas - pessoasSemEscala}/${totalPessoas}
                        </div>
                        <div style="color: #666;">Pessoas Escaladas</div>
                    </div>
                    
                    <div style="background: white; padding: 15px; border-radius: 8px; text-align: center;">
                        <div style="font-size: 2em; color: #2196f3; font-weight: bold;">
                            ${mediaServicos}
                        </div>
                        <div style="color: #666;">Média Serviços/Pessoa</div>
                    </div>
                    
                    <div style="background: white; padding: 15px; border-radius: 8px; text-align: center;">
                        <div style="font-size: 2em; color: ${pessoasNoLimite > 3 ? '#ff5722' : '#ff9800'}; font-weight: bold;">
                            ${pessoasNoLimite}
                        </div>
                        <div style="color: #666;">No Limite</div>
                    </div>
                    
                    <div style="background: white; padding: 15px; border-radius: 8px; text-align: center;">
                        <div style="font-size: 2em; color: #9c27b0; font-weight: bold;">
                            ${pessoasSubutilizadas}
                        </div>
                        <div style="color: #666;">Subutilizadas</div>
                    </div>
                </div>
                
                <div style="margin-top: 20px; background: white; padding: 15px; border-radius: 8px;">
                    <strong>Distribuição por Turno:</strong>
                    <div style="display: flex; justify-content: space-around; margin-top: 10px;">
                        <div>🌅 Manhã: ${distribuicaoTurnos.manha}</div>
                        <div>☀️ Tarde: ${distribuicaoTurnos.tarde}</div>
                        <div>🌙 Noite: ${distribuicaoTurnos.noite}</div>
                        <div>🕐 Integral: ${distribuicaoTurnos.integral}</div>
                    </div>
                </div>
                
                ${pessoasSemEscala > 0 ? `
                    <div style="margin-top: 15px; background: #fff3e0; padding: 15px; border-radius: 8px; border: 2px solid #ff9800;">
                        <strong style="color: #e65100;">⚠️ Atenção:</strong> 
                        ${pessoasSemEscala} pessoa(s) sem nenhum serviço escalado. 
                        Use o Assistente IA para entender os motivos.
                    </div>
                ` : ''}
            </div>`;
    }
    
