                if (this.pessoaOcupadaNoDia(pessoa, conflito.dia)) return false;
                
                // Verificar compatibilidade
                if (conflito.tipo === 'motorista' && !pessoa.ehMotorista) return false;
                
                // Verificar limites
                if (pessoa.pontosServico >= pessoa.limiteServicos) return false;
                
                return true;
            });
        }
        
