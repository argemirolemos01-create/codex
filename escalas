    // VISUALIZAÇÃO DA ESCALA POR PESSOA
    // =====================================
    
    function visualizarEscalaPorPessoa() {
        if (!sistema.escala || Object.keys(sistema.escala).length === 0) {
            mostrarToast('Gere uma escala primeiro!', 'warning');
            return;
        }
        
        const container = document.getElementById('escala-visualizacao');
        let html = '<h3>📋 Escala Detalhada por Pessoa</h3>';
        
        // Agrupar informações por pessoa
        const escalaPorPessoa = {};
        
        sistema.efetivo.forEach(pessoa => {
            escalaPorPessoa[pessoa.id] = {
                nome: pessoa.nome,
                escalaBase: identificarTipoEscala(pessoa),
                diasEscalaNormal: pessoa.escalaDias || [],
                servicos: [],
                totalServicos: 0,
                totalPontos: 0,
                ehMotorista: pessoa.ehMotorista,
                ehExpediente: pessoa.expedienteSegASex,
                limiteServicos: pessoa.limiteServicos
            };
        });
        
        // Coletar todos os serviços escalados
        for (let dia = 1; dia <= 30; dia++) {
            const servicosDia = sistema.escala[dia] || {};
            
            Object.values(servicosDia).forEach(servico => {
                servico.pessoas?.forEach(pessoa => {
                    if (escalaPorPessoa[pessoa.id]) {
                        const ehDiaEscalaNormal = escalaPorPessoa[pessoa.id].diasEscalaNormal.includes(dia);
                        const pontos = servico.turno === 'integral' ? 2 : 1;
                        
                        escalaPorPessoa[pessoa.id].servicos.push({
                            dia,
                            nomeServico: servico.nome,
                            turno: servico.turno,
                            ehEscalaNormal: ehDiaEscalaNormal,
                            ehExtra: !ehDiaEscalaNormal && !pessoa.expedienteSegASex,
                            pontos
                        });
                        
                        escalaPorPessoa[pessoa.id].totalServicos++;
                        escalaPorPessoa[pessoa.id].totalPontos += pontos;
                    }
                });
            });
        }
        
        // Gerar HTML para cada pessoa
        html += '<div style="margin-top: 20px;">';
        
        // Ordenar por escala base e depois por nome
        const pessoasOrdenadas = Object.values(escalaPorPessoa).sort((a, b) => {
            if (a.escalaBase !== b.escalaBase) {
                // Expediente primeiro, depois escalas numéricas
                if (a.escalaBase === 'Expediente') return -1;
                if (b.escalaBase === 'Expediente') return 1;
                return a.escalaBase.localeCompare(b.escalaBase);
            }
            return a.nome.localeCompare(b.nome);
        });
        
        let escalaAtual = '';
        
        pessoasOrdenadas.forEach(pessoa => {
            // Adicionar separador quando muda o tipo de escala
            if (pessoa.escalaBase !== escalaAtual) {
                escalaAtual = pessoa.escalaBase;
