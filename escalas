        async remanejarInteligente() {
            let melhorias = 0;
            const maxIteracoes = 100;
            let iteracao = 0;
            
            while (iteracao < maxIteracoes && this.conflitosDetectados.length > 0) {
                iteracao++;
                
                // Selecionar conflito mais crítico
                const conflito = this.selecionarConflitoMaisCritico();
                if (!conflito) break;
                
                // Tentar resolver por troca
                const trocaRealizada = await this.tentarTroca(conflito);
                
                if (trocaRealizada) {
                    melhorias++;
                    this.historicoOtimizacoes.push({
                        tipo: 'remanejamento',
                        descricao: `Resolvido conflito dia ${conflito.dia}`,
                        timestamp: Date.now()
                    });
                    
                    // Recalcular conflitos
                    this.detectarConflitos();
                } else {
                    // Tentar resolução alternativa
                    await this.tentarResolucaoAlternativa(conflito);
                }
            }
            
            this.metricas.otimizacoes = melhorias;
            return melhorias;
        }
        
        // =====================================
