                            ${pessoa.ehExpediente ? '<span style="background: #4fc3f7; padding: 2px 8px; border-radius: 4px; margin-left: 5px;">📅 Expediente</span>' : ''}
                            <span style="background: ${statusCor}; color: white; padding: 2px 8px; border-radius: 4px; margin-left: 5px;">
