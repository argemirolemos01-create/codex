    function exportarEscalaExcel() {
        if (Object.keys(sistema.escala).length === 0) {
            mostrarToast('Gere uma escala primeiro!', 'warning');
            return;
        }
        
        const dados = [];
        
        for (let dia = 1; dia <= 30; dia++) {
            const servicosDia = sistema.escala[dia] || {};
            
            Object.values(servicosDia).forEach(servico => {
                if (servico.pessoas && servico.pessoas.length > 0) {
                    servico.pessoas.forEach(pessoa => {
                        dados.push({
                            Dia: dia,
                            'Dia_Semana': ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'][new Date(2024, 0, dia).getDay()],
                            Serviço: servico.nome,
                            Turno: servico.turno,
                            Funcionário: pessoa.nome,
                            Motorista: pessoa.ehMotorista ? 'Sim' : 'Não',
                            Expediente: pessoa.expedienteSegASex ? 'Sim' : 'Não'
                        });
                    });
                } else {
                    dados.push({
                        Dia: dia,
                        'Dia_Semana': ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'][new Date(2024, 0, dia).getDay()],
                        Serviço: servico.nome,
                        Turno: servico.turno,
                        Funcionário: 'SEM COBERTURA',
                        Motorista: '-',
                        Expediente: '-'
                    });
                }
            });
        }
        
        // Criar planilha principal
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.json_to_sheet(dados);
        XLSX.utils.book_append_sheet(wb, ws, 'Escala');
        
        // Adicionar resumo estatístico
        const resumo = sistema.efetivo.map(pessoa => ({
            Nome: pessoa.nome,
            'Total_Serviços': pessoa.servicosEscalados || 0,
            'Pontos_Usados': pessoa.pontosServico || 0,
            'Limite': pessoa.limiteServicos,
            'Percentual_Uso': ((pessoa.pontosServico || 0) / pessoa.limiteServicos * 100).toFixed(1) + '%'
        }));
        
        const wsResumo = XLSX.utils.json_to_sheet(resumo);
        XLSX.utils.book_append_sheet(wb, wsResumo, 'Resumo');
        
        // Gerar nome do arquivo com data
        const hoje = new Date();
        const nomeArquivo = `escala_${hoje.getFullYear()}_${String(hoje.getMonth() + 1).padStart(2, '0')}_${String(hoje.getDate()).padStart(2, '0')}.xlsx`;
        
        XLSX.writeFile(wb, nomeArquivo);
        mostrarToast('Escala exportada com sucesso!', 'success');
    }
    
