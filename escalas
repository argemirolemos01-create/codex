        // =====================================
        
        async balancearCarga() {
            const estatisticasPessoas = this.calcularEstatisticasPessoas();
            
            // Identificar desequilíbrios
            const media = estatisticasPessoas.media;
            const desvioPadrao = estatisticasPessoas.desvioPadrao;
            
            const sobrecarregados = this.efetivo.filter(p => 
                p.servicosEscalados > media + desvioPadrao
            );
            
            const subUtilizados = this.efetivo.filter(p => 
                p.servicosEscalados < media - desvioPadrao
            );
            
            // Tentar rebalancear
            for (const pessoaSobrecarregada of sobrecarregados) {
                for (const pessoaSubUtilizada of subUtilizados) {
                    const trocaPossivel = await this.tentarRebalanceamento(
                        pessoaSobrecarregada, 
                        pessoaSubUtilizada
                    );
                    
                    if (trocaPossivel) {
                        this.metricas.otimizacoes++;
                    }
                }
            }
            
            // Calcular score de balanceamento
            this.metricas.balanceamento = this.calcularScoreBalanceamento();
        }
        
