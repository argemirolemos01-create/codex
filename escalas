        async aplicarPreferenciasPessoais() {
            // Simular preferências e aplicar quando possível
            // Por exemplo: algumas pessoas preferem manhã, outras tarde
            
            this.efetivo.forEach((pessoa, index) => {
                // Simular preferência baseada no índice
                const prefereTarde = index % 3 === 0;
                const prefereManha = index % 3 === 1;
                
                if (prefereTarde || prefereManha) {
                    // Tentar realocar para turno preferido
                    this.realocarParaTurnoPreferido(pessoa, prefereTarde ? 'tarde' : 'manha');
                }
            });
