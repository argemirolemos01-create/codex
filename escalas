        async tentarRebalanceamento(pessoaSobrecarregada, pessoaSubUtilizada) {
            // Buscar serviços que podem ser trocados
            const servicosCandidatos = pessoaSobrecarregada.historicoServicos?.filter(h => {
                // Verificar se subUtilizada pode pegar este serviço
                return this.podeAssumirServico(pessoaSubUtilizada, h);
            });
            
            if (servicosCandidatos && servicosCandidatos.length > 0) {
                // Executar troca
                const servico = servicosCandidatos[0];
                await this.trocarPessoaServico(
                    servico.dia, 
                    servico.servico, 
                    pessoaSobrecarregada, 
                    pessoaSubUtilizada
                );
                return true;
            }
            
            return false;
        }
        
        podeAssumirServico(pessoa, historicoServico) {
            // Verificar se pessoa pode assumir o serviço
            // Implementação simplificada
            return pessoa.pontosServico < pessoa.limiteServicos;
        }
        
        async trocarPessoaServico(dia, servicoId, pessoaOriginal, pessoaNova) {
            const servico = this.escala[dia]?.[servicoId];
            if (!servico) return;
            
            const index = servico.pessoas.findIndex(p => p.id === pessoaOriginal.id);
            if (index !== -1) {
                servico.pessoas[index] = pessoaNova;
                
                // Atualizar contadores
                pessoaOriginal.servicosEscalados--;
                pessoaNova.servicosEscalados++;
            }
        }
        
        calcularEstatisticasPessoas() {
            const valores = this.efetivo.map(p => p.servicosEscalados || 0);
            const media = valores.reduce((a, b) => a + b, 0) / valores.length;
            
            const variancia = valores.reduce((acc, val) => 
                acc + Math.pow(val - media, 2), 0
            ) / valores.length;
            
            const desvioPadrao = Math.sqrt(variancia);
            
            return { media, desvioPadrao, valores };
        }
        
        calcularScoreBalanceamento() {
            const stats = this.calcularEstatisticasPessoas();
            const coeficienteVariacao = stats.desvioPadrao / stats.media;
            
            // Score de 0 a 100 (menor variação = maior score)
            return Math.max(0, 100 - (coeficienteVariacao * 100));
        }
        
        async otimizarTurnosConsecutivos() {
            // Evitar turnos pesados consecutivos
            for (let dia = 2; dia <= 30; dia++) {
                const servicosHoje = this.escala[dia] || {};
                const servicosOntem = this.escala[dia - 1] || {};
                
                for (const servicoHoje of Object.values(servicosHoje)) {
                    if (servicoHoje.turno === 'integral' || servicoHoje.turno === 'noite') {
                        // Verificar se alguém fez turno pesado ontem
                        servicoHoje.pessoas = servicoHoje.pessoas?.filter(pessoa => {
                            const trabalhouPesadoOntem = Object.values(servicosOntem).some(s => 
                                (s.turno === 'integral' || s.turno === 'noite') &&
                                s.pessoas?.some(p => p.id === pessoa.id)
                            );
                            return !trabalhouPesadoOntem;
                        });
                    }
                }
            }
        }
        
        async otimizarMotoristas() {
            // Distribuir motoristas de forma equilibrada
            const servicosComMotorista = this.servicos.filter(s => s.requerMotorista);
            const motoristas = this.efetivo.filter(p => p.ehMotorista);
            
            // Garantir rotação de motoristas
            let motoristaIndex = 0;
            
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.escala[dia] || {};
                
                Object.values(servicosDia).forEach(servico => {
                    if (servico.requerMotorista) {
                        const temMotorista = servico.pessoas?.some(p => p.ehMotorista);
                        
                        if (!temMotorista && motoristas.length > 0) {
                            // Alocar próximo motorista disponível
                            const motorista = motoristas[motoristaIndex % motoristas.length];
                            if (!this.pessoaOcupadaNoDia(motorista, dia)) {
                                servico.pessoas = servico.pessoas || [];
                                servico.pessoas.push(motorista);
                                motoristaIndex++;
                            }
                        }
                    }
                });
            }
        }
        
        async otimizarIntegrais() {
            // Garantir isolamento adequado para integrais
            for (let dia = 2; dia <= 29; dia++) {
                const servicosDia = this.escala[dia] || {};
                
                Object.values(servicosDia).forEach(servico => {
                    if (servico.turno === 'integral') {
                        servico.pessoas?.forEach(pessoa => {
                            // Remover pessoa dos dias adjacentes
                            this.removerPessoaDia(pessoa, dia - 1);
                            this.removerPessoaDia(pessoa, dia + 1);
                        });
                    }
                });
            }
        }
        
        removerPessoaDia(pessoa, dia) {
            if (!this.escala[dia]) return;
            
            Object.values(this.escala[dia]).forEach(servico => {
                if (servico.pessoas) {
                    servico.pessoas = servico.pessoas.filter(p => p.id !== pessoa.id);
                }
            });
        }
        
        async otimizarFinsDesemana() {
            // Distribuir fins de semana de forma justa
            const finsDesemana = [];
            for (let dia = 1; dia <= 30; dia++) {
                const date = new Date(2024, 0, dia); // Mês simplificado
                if (date.getDay() === 0 || date.getDay() === 6) {
                    finsDesemana.push(dia);
                }
            }
            
            // Criar rotação para fins de semana
            let pessoaIndex = 0;
            
            finsDesemana.forEach(dia => {
                const servicosDia = this.escala[dia] || {};
                
                Object.values(servicosDia).forEach(servico => {
                    if (servico.pessoas?.length < servico.limitePessoas) {
                        // Completar com rotação
                        const pessoa = this.efetivo[pessoaIndex % this.efetivo.length];
                        if (!this.pessoaOcupadaNoDia(pessoa, dia)) {
                            servico.pessoas.push(pessoa);
                            pessoaIndex++;
                        }
                    }
                });
            });
