        explicarNaoEscalacao(nomePessoa) {
            // Buscar pessoa
            const pessoa = this.sistema.efetivo.find(p => 
                p.nome.toLowerCase().includes(nomePessoa.toLowerCase())
            );
            
            if (!pessoa) {
                return `❌ Pessoa "${nomePessoa}" não encontrada. Verifique o nome e tente novamente.`;
            }
            
            let resposta = `🔍 **Análise de ${pessoa.nome}**\n\n`;
            
            // Informações básicas
            resposta += `📊 **Situação Atual:**\n`;
            resposta += `• Serviços: ${pessoa.servicosEscalados || 0}\n`;
            resposta += `• Pontos usados: ${pessoa.pontosServico || 0}/${pessoa.limiteServicos}\n`;
            resposta += `• Motorista: ${pessoa.ehMotorista ? 'Sim' : 'Não'}\n`;
            resposta += `• Expediente: ${pessoa.expedienteSegASex ? 'Sim' : 'Não'}\n\n`;
            
            // Analisar restrições
            resposta += `🚫 **Restrições:**\n`;
            
            if (pessoa.diasExclusao?.length > 0) {
                resposta += `• Dias bloqueados: ${pessoa.diasExclusao.join(', ')}\n`;
            }
            
            if (pessoa.turnosProibidos?.length > 0) {
                resposta += `• Turnos proibidos: ${pessoa.turnosProibidos.join(', ')}\n`;
            }
            
            if (pessoa.escalaDias?.length > 0) {
                resposta += `• Dias de escala normal: ${pessoa.escalaDias.slice(0, 5).join(', ')}...\n`;
            }
            
            // Análise de disponibilidade
            let diasDisponiveis = 0;
            for (let dia = 1; dia <= 30; dia++) {
                if (!pessoa.diasExclusao?.includes(dia) && 
                    !pessoa.escalaDias?.includes(dia)) {
                    diasDisponiveis++;
                }
            }
            
            resposta += `\n📅 **Disponibilidade:**\n`;
            resposta += `• ${diasDisponiveis} dias disponíveis no mês\n`;
            
            if (pessoa.servicosEscalados === 0) {
                resposta += `\n⚠️ **Motivo provável:** `;
                if (pessoa.pontosServico >= pessoa.limiteServicos) {
                    resposta += `Limite de pontos atingido`;
                } else if (diasDisponiveis === 0) {
                    resposta += `Nenhum dia disponível (escala normal + exclusões)`;
                } else if (pessoa.turnosProibidos?.length >= 3) {
                    resposta += `Muitos turnos proibidos`;
                } else {
                    resposta += `Conflito de horários ou restrições muito específicas`;
                }
            }
            
            return resposta;
        }
        
        listarDisponiveisDia(dia) {
            if (dia < 1 || dia > 30) {
                return `❌ Dia inválido. Use um número entre 1 e 30.`;
            }
            
            let resposta = `📅 **Pessoas disponíveis para o dia ${dia}:**\n\n`;
            
            const disponiveis = this.sistema.efetivo.filter(p => {
                // Verificar exclusões
                if (p.diasExclusao?.includes(dia)) return false;
                
                // Verificar escala normal
                if (!p.expedienteSegASex && p.escalaDias?.includes(dia)) return false;
                
                // Verificar se já está escalado
                if (this.sistema.escala[dia]) {
                    const jaEscalado = Object.values(this.sistema.escala[dia]).some(s =>
                        s.pessoas?.some(pessoa => pessoa.id === p.id)
                    );
                    if (jaEscalado) return false;
                }
                
                return true;
            });
            
            if (disponiveis.length === 0) {
                resposta += `Nenhuma pessoa disponível para este dia.`;
            } else {
                disponiveis.forEach(p => {
                    resposta += `• ${p.nome}`;
                    if (p.ehMotorista) resposta += ` 🚗`;
                    if (p.expedienteSegASex) resposta += ` (Exp)`;
                    resposta += ` - ${p.limiteServicos - (p.pontosServico || 0)} pts disponíveis\n`;
                });
            }
            
            return resposta;
        }
        
        analisarDia(dia) {
            if (dia < 1 || dia > 30) {
                return `❌ Dia inválido. Use um número entre 1 e 30.`;
            }
            
            let resposta = `📊 **Análise do dia ${dia}:**\n\n`;
            
            const servicosDia = this.sistema.escala[dia];
            
            if (!servicosDia || Object.keys(servicosDia).length === 0) {
                return resposta + `Nenhum serviço agendado para este dia.`;
            }
            
            let totalNecessario = 0;
            let totalPreenchido = 0;
            
            Object.values(servicosDia).forEach(servico => {
                totalNecessario += servico.limitePessoas;
                totalPreenchido += servico.pessoas?.length || 0;
                
                resposta += `**${servico.nome}** (${servico.turno})\n`;
                resposta += `• Necessário: ${servico.limitePessoas} | Alocado: ${servico.pessoas?.length || 0}\n`;
                
                if (servico.pessoas?.length > 0) {
                    resposta += `• Equipe: ${servico.pessoas.map(p => p.nome).join(', ')}\n`;
                } else {
                    resposta += `• ⚠️ SEM COBERTURA\n`;
                }
                resposta += `\n`;
            });
            
            const taxaCobertura = totalNecessario > 0 ? 
                (totalPreenchido / totalNecessario * 100).toFixed(0) : 0;
            
            resposta += `📈 **Taxa de cobertura:** ${taxaCobertura}%`;
            
            return resposta;
        }
        
        mostrarEscalaPessoa(nomePessoa) {
            const pessoa = this.sistema.efetivo.find(p => 
                p.nome.toLowerCase().includes(nomePessoa.toLowerCase())
            );
            
            if (!pessoa) {
                return `❌ Pessoa "${nomePessoa}" não encontrada.`;
            }
            
            let resposta = `📅 **Escala de ${pessoa.nome}:**\n\n`;
            
            if (!pessoa.historicoServicos || pessoa.historicoServicos.length === 0) {
                return resposta + `Nenhum serviço escalado.`;
            }
            
            // Agrupar por semana
            const servicos = [...pessoa.historicoServicos].sort((a, b) => a.dia - b.dia);
            
            servicos.forEach(s => {
                const servico = this.sistema.servicos.find(serv => serv.id === s.servico);
                resposta += `• Dia ${s.dia}: ${servico?.nome || 'Serviço'} (${s.turno})`;
                if (s.pontos === 2) resposta += ` [2pts]`;
                resposta += `\n`;
            });
            
            resposta += `\n📊 **Resumo:**\n`;
            resposta += `• Total: ${pessoa.servicosEscalados} serviços\n`;
            resposta += `• Pontos: ${pessoa.pontosServico}/${pessoa.limiteServicos}`;
            
            return resposta;
        }
        
        executarOtimizacao() {
            if (this.sistema.efetivo.length === 0 || this.sistema.servicos.length === 0) {
                return `⚠️ Adicione pessoas e serviços antes de otimizar.`;
            }
            
            // Executar otimização
            this.sistema.otimizarEscalaCompleta();
            
            return `🚀 **Otimização iniciada!**\n\n` +
                   `Processando em 6 fases:\n` +
                   `✅ Análise de dados\n` +
                   `✅ Distribuição otimizada\n` +
                   `✅ Detecção de conflitos\n` +
                   `✅ Remanejamento inteligente\n` +
                   `✅ Balanceamento de carga\n` +
                   `✅ Aplicação de IA\n\n` +
                   `Verifique as métricas atualizadas no dashboard!`;
        }
        
