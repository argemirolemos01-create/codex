    function adicionarPessoa() {
        const nome = document.getElementById('nome-pessoa').value.trim();
        if (!nome) {
            mostrarToast('Nome é obrigatório!', 'warning');
            return;
        }
        
        const escalaTexto = document.getElementById('escala-pessoa').value.trim();
        let escalaDias = [];
        
        // Expansão automática para escalas 1-4
        if (/^[1-4]$/.test(escalaTexto)) {
            const numero = parseInt(escalaTexto);
            for (let i = 0; i < 8; i++) {
                const dia = numero + (i * 4);
                if (dia <= 31) escalaDias.push(dia);
            }
        } else if (escalaTexto) {
            escalaDias = escalaTexto.split(',').map(d => parseInt(d.trim())).filter(d => d >= 1 && d <= 31);
        }
        
        const diasExclusaoTexto = document.getElementById('dias-exclusao').value.trim();
        const diasExclusao = diasExclusaoTexto ? 
            diasExclusaoTexto.split(',').map(d => parseInt(d.trim())).filter(d => d >= 1 && d <= 31) : [];
        
        const restricoesTexto = document.getElementById('restricoes-turno').value.trim().toLowerCase();
        const turnosProibidos = restricoesTexto ? 
            restricoesTexto.split(',').map(t => t.trim()).filter(t => ['manha', 'tarde', 'noite', 'integral'].includes(t)) : [];
        
        const novaPessoa = {
            id: Date.now() + Math.random(),
            nome,
            ehMotorista: document.getElementById('is-motorista').checked,
            expedienteSegASex: document.getElementById('is-expediente').checked,
            limiteServicos: parseInt(document.getElementById('limite-servicos').value) || 10,
