    class AssistenteIA {
        constructor(sistema) {
            this.sistema = sistema;
            this.historicoConversa = [];
            this.comandos = new Map();
            this.configurarComandos();
        }
        
        configurarComandos() {
            // Comando: Status geral
            this.comandos.set(/^status|situação|resumo$/i, () => this.gerarStatus());
            
            // Comando: Problemas detectados
            this.comandos.set(/problemas?|erros?|conflitos?/i, () => this.listarProblemas());
            
            // Comando: Sugestões
            this.comandos.set(/sugest|dica|melhori|otimiz/i, () => this.gerarSugestoes());
            
            // Comando: Por que X não foi escalado
            this.comandos.set(/por\s*que\s+(.*?)\s*não\s*(?:foi|está)\s*escalad/i, 
                (match) => this.explicarNaoEscalacao(match[1]));
            
            // Comando: Quem pode trabalhar dia X
            this.comandos.set(/quem\s*pode\s*(?:trabalhar|cobrir)?\s*dia\s*(\d+)/i, 
                (match) => this.listarDisponiveisDia(parseInt(match[1])));
            
            // Comando: Analisar dia X
            this.comandos.set(/analis\w*\s*dia\s*(\d+)/i, 
                (match) => this.analisarDia(parseInt(match[1])));
            
            // Comando: Escala de pessoa
            this.comandos.set(/escala\s*(?:de|do|da)\s*(.+)/i, 
                (match) => this.mostrarEscalaPessoa(match[1]));
            
            // Comando: Otimizar automaticamente
            this.comandos.set(/^otimizar$|otimização\s*automática/i, 
                () => this.executarOtimizacao());
            
            // Comando: Estatísticas
            this.comandos.set(/estatística|métricas|números/i, 
                () => this.mostrarEstatisticas());
            
            // Comando: Ajuda
            this.comandos.set(/ajuda|help|comandos|o que você pode/i, 
                () => this.mostrarAjuda());
        }
        
        processarMensagem(mensagem) {
            // Adicionar ao histórico
            this.historicoConversa.push({
                tipo: 'usuario',
                mensagem,
                timestamp: new Date()
            });
            
            // Processar comando
            let resposta = null;
            
            // Verificar comandos registrados
            for (const [pattern, handler] of this.comandos) {
                const match = mensagem.match(pattern);
                if (match) {
                    resposta = handler(match);
                    break;
                }
            }
            
            // Se não encontrou comando, usar processamento de linguagem natural
            if (!resposta) {
                resposta = this.processarLinguagemNatural(mensagem);
            }
            
            // Adicionar resposta ao histórico
            this.historicoConversa.push({
                tipo: 'assistente',
                mensagem: resposta,
                timestamp: new Date()
            });
            
            return resposta;
        }
        
        processarLinguagemNatural(mensagem) {
            const msgLower = mensagem.toLowerCase();
            
            // Detectar intenções
            if (msgLower.includes('não') && msgLower.includes('escalad')) {
                return this.explicarProblemasGerais();
            }
            
            if (msgLower.includes('falta') || msgLower.includes('descobert')) {
                return this.listarServicosDescobertos();
            }
            
            if (msgLower.includes('trocar') || msgLower.includes('substituir')) {
                return this.sugerirTrocas();
            }
            
            if (msgLower.includes('motorista')) {
                return this.analisarMotoristas();
            }
            
            if (msgLower.includes('integral')) {
                return this.analisarIntegrais();
            }
            
            if (msgLower.includes('noite') || msgLower.includes('noturno')) {
                return this.analisarNoturnos();
            }
            
            // Resposta padrão
            return `Não entendi completamente sua pergunta. Você pode tentar:
            
• "status" - ver situação geral
• "problemas" - listar conflitos
• "sugestões" - obter recomendações
• "por que [nome] não foi escalado?" - explicação detalhada
• "analisar dia [número]" - análise de um dia específico
• "quem pode dia [número]?" - pessoas disponíveis
            
Como posso ajudar?`;
        }
        
        gerarStatus() {
            const metricas = this.sistema.metricas;
            const totalPessoas = this.sistema.efetivo.length;
            const totalServicos = this.sistema.servicos.length;
            
            let status = `📊 **STATUS DO SISTEMA**\n\n`;
            
            // Verificar se há escala gerada
            if (!this.sistema.escala || Object.keys(this.sistema.escala).length === 0) {
                status += `⚠️ Nenhuma escala gerada ainda.\n\n`;
                status += `• ${totalPessoas} pessoas cadastradas\n`;
                status += `• ${totalServicos} serviços cadastrados\n\n`;
                status += `Use o botão "Otimizar Tudo" para gerar a escala.`;
                return status;
            }
            
            // Métricas principais
            status += `✅ **Eficiência Geral:** ${metricas.eficiencia.toFixed(0)}%\n`;
            status += `📈 **Cobertura:** ${metricas.cobertura.toFixed(0)}%\n`;
            status += `⚖️ **Balanceamento:** ${metricas.balanceamento.toFixed(0)}%\n`;
            status += `⚠️ **Conflitos:** ${metricas.conflitos}\n`;
            status += `🔧 **Otimizações:** ${metricas.otimizacoes}\n\n`;
            
            // Análise qualitativa
            if (metricas.eficiencia >= 90) {
                status += `🎉 Excelente! A escala está muito bem otimizada.`;
            } else if (metricas.eficiencia >= 75) {
                status += `👍 Bom resultado, mas há espaço para melhorias.`;
            } else if (metricas.eficiencia >= 60) {
                status += `⚠️ Escala funcional, mas recomendo otimização.`;
            } else {
                status += `❌ Escala precisa de ajustes urgentes.`;
            }
            
            return status;
        }
        
        listarProblemas() {
            let resposta = `⚠️ **PROBLEMAS DETECTADOS**\n\n`;
            
            if (!this.sistema.conflitosDetectados || this.sistema.conflitosDetectados.length === 0) {
                return resposta + `✅ Nenhum conflito detectado! A escala está livre de violações de regras.`;
            }
            
            // Agrupar conflitos por tipo
            const conflitosAgrupados = {};
            this.sistema.conflitosDetectados.forEach(conflito => {
                if (!conflitosAgrupados[conflito.tipo]) {
                    conflitosAgrupados[conflito.tipo] = [];
                }
                conflitosAgrupados[conflito.tipo].push(conflito);
            });
            
            // Exibir por tipo
            Object.entries(conflitosAgrupados).forEach(([tipo, conflitos]) => {
                resposta += `**${this.formatarTipoConflito(tipo)}** (${conflitos.length})\n`;
                
                conflitos.slice(0, 3).forEach(c => {
                    resposta += `• Dia ${c.dia}: ${c.descricao}\n`;
                });
                
                if (conflitos.length > 3) {
                    resposta += `• ... e mais ${conflitos.length - 3}\n`;
                }
                resposta += `\n`;
            });
            
            resposta += `💡 Dica: Use "sugestões" para ver como resolver estes problemas.`;
            
            return resposta;
        }
        
        gerarSugestoes() {
            let sugestoes = `💡 **SUGESTÕES INTELIGENTES**\n\n`;
            
            // Analisar situação atual
            const problemas = this.analisarProblemasPrincipais();
            
            if (problemas.pessoasSemEscala > 0) {
                sugestoes += `👥 **Pessoas Subutilizadas**\n`;
                sugestoes += `• ${problemas.pessoasSemEscala} pessoas sem nenhum serviço\n`;
                sugestoes += `• Considere redistribuir serviços ou revisar restrições\n\n`;
            }
            
            if (problemas.servicosDescobertos > 0) {
                sugestoes += `📋 **Serviços Descobertos**\n`;
                sugestoes += `• ${problemas.servicosDescobertos} posições sem cobertura\n`;
                sugestoes += `• Sugestão: Adicionar pessoas com exceção ou flexibilizar restrições\n\n`;
            }
            
            if (problemas.desbalanceamento > 30) {
                sugestoes += `⚖️ **Desbalanceamento Detectado**\n`;
                sugestoes += `• Diferença de ${problemas.desbalanceamento}% na distribuição\n`;
                sugestoes += `• Execute "otimizar" para rebalancear automaticamente\n\n`;
            }
            
            // Sugestões específicas
            sugestoes += `🎯 **Ações Recomendadas:**\n`;
            sugestoes += `1. Digite "otimizar" para melhorar automaticamente\n`;
            sugestoes += `2. Revise pessoas com muitas restrições\n`;
            sugestoes += `3. Considere adicionar exceções para pessoas voluntárias\n`;
            sugestoes += `4. Verifique se há motoristas suficientes para serviços noturnos`;
            
