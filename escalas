        async preverProblemasFuturos() {
            // Simular previsão de problemas usando padrões
            const problemasPotenciais = [];
            
            // Verificar fadiga acumulada
            this.efetivo.forEach(pessoa => {
                const cargaPercentual = (pessoa.pontosServico || 0) / pessoa.limiteServicos;
                if (cargaPercentual > 0.9) {
                    problemasPotenciais.push({
                        tipo: 'fadiga',
                        pessoa: pessoa.nome,
                        risco: 'alto'
                    });
                }
            });
            
            // Verificar concentração de serviços
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = Object.values(this.escala[dia] || {});
                if (servicosDia.length > 5) {
                    problemasPotenciais.push({
                        tipo: 'sobrecarga_dia',
                        dia,
                        risco: 'médio'
                    });
                }
            }
            
            return problemasPotenciais;
        }
        
        calcularMetricas() {
            // Eficiência geral
            let totalNecessario = 0;
            let totalPreenchido = 0;
            
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.escala[dia] || {};
                Object.values(servicosDia).forEach(servico => {
                    totalNecessario += servico.limitePessoas;
                    totalPreenchido += servico.pessoas?.length || 0;
                });
            }
            
            this.metricas.cobertura = totalNecessario > 0 ? 
                (totalPreenchido / totalNecessario * 100) : 0;
            
            // Eficiência = média ponderada de todas as métricas
            this.metricas.eficiencia = (
                this.metricas.cobertura * 0.4 +
                this.metricas.balanceamento * 0.3 +
                (100 - Math.min(100, this.metricas.conflitos * 5)) * 0.3
            );
        }
        
        gerarSugestoesIA() {
            this.sugestoesIA = [];
            
            // Análise de padrões e geração de sugestões
            if (this.metricas.cobertura < 90) {
                this.sugestoesIA.push({
                    tipo: 'cobertura',
                    titulo: 'Melhorar Cobertura',
                    descricao: `Cobertura atual: ${this.metricas.cobertura.toFixed(1)}%`,
                    acoes: [
                        'Considere adicionar pessoas com exceção às regras',
                        'Revise os limites de serviços por pessoa',
                        'Avalie contratar temporários para picos'
                    ]
                });
            }
            
            if (this.metricas.balanceamento < 70) {
                this.sugestoesIA.push({
                    tipo: 'balanceamento',
                    titulo: 'Equilibrar Carga',
                    descricao: 'Distribuição desigual detectada',
                    acoes: [
                        'Redistribuir serviços entre pessoas',
                        'Implementar rotação automática',
                        'Ajustar limites individuais'
                    ]
                });
            }
            
            if (this.metricas.conflitos > 5) {
                this.sugestoesIA.push({
                    tipo: 'conflitos',
                    titulo: 'Resolver Conflitos',
                    descricao: `${this.metricas.conflitos} conflitos detectados`,
                    acoes: [
                        'Revisar regras de intervalo',
                        'Flexibilizar algumas restrições',
                        'Considerar turnos alternativos'
                    ]
                });
            }
            
            // Sugestões proativas baseadas em padrões
            const padroes = this.identificarPadroes();
            if (padroes.length > 0) {
                this.sugestoesIA.push({
                    tipo: 'padrao',
                    titulo: 'Padrões Identificados',
                    descricao: 'A IA detectou oportunidades de melhoria',
                    acoes: padroes
                });
            }
        }
        
        identificarPadroes() {
            const padroes = [];
            
            // Padrão: Concentração em dias específicos
            const servicosPorDia = {};
            for (let dia = 1; dia <= 30; dia++) {
                servicosPorDia[dia] = Object.keys(this.escala[dia] || {}).length;
            }
            
            const diasSobrecarregados = Object.entries(servicosPorDia)
                .filter(([dia, qtd]) => qtd > 5)
                .map(([dia]) => dia);
            
            if (diasSobrecarregados.length > 0) {
                padroes.push(`Dias sobrecarregados: ${diasSobrecarregados.join(', ')}`);
            }
            
            // Padrão: Pessoas sempre nos mesmos turnos
            this.efetivo.forEach(pessoa => {
                const turnos = pessoa.historicoServicos?.map(h => h.turno) || [];
                const turnoMaisFrequente = this.modaArray(turnos);
                
                if (turnoMaisFrequente && turnos.filter(t => t === turnoMaisFrequente).length > turnos.length * 0.7) {
                    padroes.push(`${pessoa.nome} sempre em ${turnoMaisFrequente}`);
                }
            });
            
            return padroes;
        }
        
        modaArray(arr) {
            if (arr.length === 0) return null;
            
            const frequencia = {};
            let maxFreq = 0;
            let moda = null;
            
            arr.forEach(item => {
                frequencia[item] = (frequencia[item] || 0) + 1;
                if (frequencia[item] > maxFreq) {
                    maxFreq = frequencia[item];
                    moda = item;
                }
            });
            
            return moda;
        }
    }
    
