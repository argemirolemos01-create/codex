    function importarPlanilhaEfetivo(event) {
        const arquivo = event.target.files[0];
        if (!arquivo) return;
        
        const reader = new FileReader();
        
        reader.onload = function(e) {
            try {
                let dados;
                
                if (arquivo.name.toLowerCase().endsWith('.csv')) {
                    // Parse CSV
                    const texto = e.target.result;
                    const resultado = Papa.parse(texto, {
                        header: true,
                        skipEmptyLines: true,
                        dynamicTyping: true
                    });
                    dados = resultado.data;
                } else {
                    // Parse Excel
                    const workbook = XLSX.read(e.target.result, { type: 'array' });
                    const worksheet = workbook.Sheets[workbook.SheetNames[0]];
                    dados = XLSX.utils.sheet_to_json(worksheet);
                }
                
                processarDadosEfetivo(dados);
                
            } catch (error) {
                mostrarToast('Erro ao processar planilha: ' + error.message, 'error');
            }
        };
        
        if (arquivo.name.toLowerCase().endsWith('.csv')) {
            reader.readAsText(arquivo, 'UTF-8');
        } else {
            reader.readAsArrayBuffer(arquivo);
        }
    }
    
    function processarDadosEfetivo(dados) {
        let importados = 0;
        let erros = 0;
        
        dados.forEach(linha => {
            try {
                const nome = (linha.Nome || '').toString().trim();
                if (!nome) return;
                
                // Processar escala
                let escalaDias = [];
                const escalaInput = (linha.Escala || '').toString().trim();
                
                if (/^[1-4]$/.test(escalaInput)) {
                    const numero = parseInt(escalaInput);
                    for (let i = 0; i < 8; i++) {
                        const dia = numero + (i * 4);
                        if (dia <= 31) escalaDias.push(dia);
                    }
                } else if (escalaInput) {
                    escalaDias = escalaInput.split(/[,;]/)
                        .map(d => parseInt(d))
                        .filter(d => !isNaN(d) && d >= 1 && d <= 31);
                }
                
                // Processar dias de exclusão
                let diasExclusao = [];
                const diasExclusaoInput = linha.Dias_Exclusao;
                
                if (diasExclusaoInput) {
                    if (typeof diasExclusaoInput === 'string') {
                        diasExclusao = diasExclusaoInput.split(/[,;]/)
                            .map(d => parseInt(d))
                            .filter(d => !isNaN(d) && d >= 1 && d <= 31);
                    } else if (typeof diasExclusaoInput === 'number') {
                        diasExclusao = [diasExclusaoInput];
                    }
                }
                
                // Processar restrições de turno
                let turnosProibidos = [];
                const turnosInput = (linha.Restricoes_Turno || '').toString().toLowerCase();
                
                if (turnosInput) {
                    turnosProibidos = turnosInput.split(/[,;]/)
                        .map(t => t.trim())
                        .filter(t => ['manha', 'tarde', 'noite', 'integral'].includes(t));
                }
                
                const novaPessoa = {
                    id: Date.now() + Math.random() + importados,
                    nome,
                    ehMotorista: ['sim', 's', '1', 'true', 'x'].includes(
                        (linha.Motorista || '').toString().toLowerCase().trim()
                    ),
                    expedienteSegASex: ['sim', 's', '1', 'true', 'x'].includes(
                        (linha.Exp || '').toString().toLowerCase().trim()
                    ),
                    limiteServicos: parseInt(linha.Limite_Servicos) || 10,
                    escalaDias,
                    diasExclusao,
                    turnosProibidos,
                    excecaoRegras: ['sim', 's', '1', 'true', 'x'].includes(
                        (linha.Excecao_Regras || '').toString().toLowerCase().trim()
                    ),
                    servicosEscalados: 0,
                    pontosServico: 0
                };
                
                sistema.efetivo.push(novaPessoa);
                importados++;
                
            } catch (err) {
                erros++;
                console.error('Erro ao processar linha:', err);
            }
        });
        
        atualizarListaEfetivo();
        
        if (importados > 0) {
            mostrarToast(`✅ ${importados} pessoas importadas com sucesso!`, 'success');
        }
        if (erros > 0) {
            mostrarToast(`⚠️ ${erros} linhas com erro foram ignoradas`, 'warning');
        }
        
        // Limpar input
        document.getElementById('arquivo-efetivo').value = '';
    }
    
    function importarPlanilhaServicos(event) {
        const arquivo = event.target.files[0];
        if (!arquivo) return;
        
        const reader = new FileReader();
        
        reader.onload = function(e) {
            try {
                let dados;
                
                if (arquivo.name.toLowerCase().endsWith('.csv')) {
                    // Parse CSV
                    const texto = e.target.result;
                    const resultado = Papa.parse(texto, {
                        header: true,
                        skipEmptyLines: true,
                        dynamicTyping: true
                    });
                    dados = resultado.data;
                } else {
                    // Parse Excel
                    const workbook = XLSX.read(e.target.result, { type: 'array' });
                    const worksheet = workbook.Sheets[workbook.SheetNames[0]];
                    dados = XLSX.utils.sheet_to_json(worksheet);
                }
                
                processarDadosServicos(dados);
                
            } catch (error) {
                mostrarToast('Erro ao processar planilha: ' + error.message, 'error');
            }
        };
        
        if (arquivo.name.toLowerCase().endsWith('.csv')) {
            reader.readAsText(arquivo, 'UTF-8');
        } else {
            reader.readAsArrayBuffer(arquivo);
        }
    }
    
    function processarDadosServicos(dados) {
        let importados = 0;
        let erros = 0;
        
        dados.forEach(linha => {
            try {
                const nome = (linha.Nome || '').toString().trim();
                const turno = (linha.Turno || '').toString().toLowerCase().trim();
                
                if (!nome || !['manha', 'tarde', 'noite', 'integral'].includes(turno)) {
                    erros++;
                    return;
                }
                
                // Processar dias disponíveis
                let diasDisponiveis = [];
                const diasInput = linha.Dias_Disponiveis;
                
                if (diasInput) {
                    if (typeof diasInput === 'string') {
                        if (diasInput.toLowerCase() === 'todos') {
                            diasDisponiveis = Array.from({length: 30}, (_, i) => i + 1);
                        } else {
                            diasDisponiveis = diasInput.split(/[,;]/)
                                .map(d => parseInt(d))
                                .filter(d => !isNaN(d) && d >= 1 && d <= 31);
                        }
                    } else if (typeof diasInput === 'number') {
                        diasDisponiveis = [diasInput];
                    }
                }
                
                if (diasDisponiveis.length === 0) {
                    erros++;
                    return;
                }
                
                const novoServico = {
                    id: Date.now() + Math.random() + importados,
                    nome,
                    turno,
                    diasDisponiveis,
                    limitePessoas: parseInt(linha.Limite_Pessoas) || 2,
                    requerMotorista: ['sim', 's', '1', 'true', 'x'].includes(
                        (linha.Requer_Motorista || '').toString().toLowerCase().trim()
                    )
                };
                
                sistema.servicos.push(novoServico);
                importados++;
                
            } catch (err) {
                erros++;
                console.error('Erro ao processar linha:', err);
            }
        });
        
        atualizarListaServicos();
        
        if (importados > 0) {
            mostrarToast(`✅ ${importados} serviços importados com sucesso!`, 'success');
        }
        if (erros > 0) {
            mostrarToast(`⚠️ ${erros} linhas com erro foram ignoradas`, 'warning');
        }
        
        // Limpar input
        document.getElementById('arquivo-servicos').value = '';
    }
    
