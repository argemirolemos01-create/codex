        calcularFlexibilidade(pessoa) {
            let score = 1.0;
            
            // Penalizar por restrições
            score -= (pessoa.turnosProibidos?.length || 0) * 0.15;
            score -= (pessoa.diasExclusao?.length || 0) * 0.02;
            
            // Bonificar por características positivas
            if (pessoa.ehMotorista) score += 0.2;
            if (pessoa.excecaoRegras) score += 0.15;
            if (!pessoa.expedienteSegASex) score += 0.1;
            
            // Bonificar por alta disponibilidade
            const taxaDisponibilidade = pessoa.limiteServicos / 15;
            score += taxaDisponibilidade * 0.2;
            
            return Math.max(0, Math.min(1, score));
        }
        
        calcularCriticidade(servico) {
            let score = 0;
            
            // Fator: disponibilidade de pessoas
            const disponiveis = this.contarDisponiveis(servico);
            const razao = servico.limitePessoas / disponiveis;
            score += razao * 50;
            
            // Fator: turno
            const pesosTurno = {
                'integral': 40,
                'noite': 30,
                'manha': 20,
                'tarde': 10
            };
            score += pesosTurno[servico.turno] || 0;
            
            // Fator: motorista
            if (servico.requerMotorista) score += 25;
            
            return score;
        }
        
        contarDisponiveis(servico) {
            return this.efetivo.filter(p => {
                if (p.turnosProibidos?.includes(servico.turno)) return false;
                if (servico.requerMotorista && !p.ehMotorista) return false;
                return true;
            }).length;
        }
        
        criarMatrizCompatibilidade() {
            const matriz = {};
            
            this.efetivo.forEach(pessoa => {
                matriz[pessoa.id] = {};
                
                this.servicos.forEach(servico => {
                    matriz[pessoa.id][servico.id] = this.calcularCompatibilidade(pessoa, servico);
                });
            });
            
            return matriz;
        }
        
        calcularCompatibilidade(pessoa, servico, dia) {
            let score = 100;
            
            // Verificações básicas que retornam 0 (impossível)
            if (pessoa.turnosProibidos?.includes(servico.turno)) return 0;
            if (servico.requerMotorista && !pessoa.ehMotorista) return 0;
            if (pessoa.diasExclusao?.includes(dia)) return 0;
            
            // Verificação de pontos disponíveis
            const pontosNecessarios = servico.turno === 'integral' ? 2 : 1;
            const pontosDisponivel = pessoa.limiteServicos - (pessoa.pontosServico || 0);
            if (pontosDisponivel < pontosNecessarios) return 0;
            
            // Regras de expediente
            const data = new Date(this.mesAnoGlobal?.ano || 2024, (this.mesAnoGlobal?.mes || 1) - 1, dia);
            const diaSemana = data.getDay();
            
            if (pessoa.expedienteSegASex) {
                if (servico.turno === 'noite') return 0;
                if (diaSemana >= 1 && diaSemana <= 5 && 
                    (servico.turno === 'manha' || servico.turno === 'integral')) return 0;
                if (servico.turno === 'tarde') score += 30;
            }
            
            // VERIFICAÇÕES CRÍTICAS PARA ESCALA NORMAL
            if (!pessoa.expedienteSegASex && pessoa.escalaDias && pessoa.escalaDias.length > 0) {
                // Não pode trabalhar no próprio dia de escala normal
                if (pessoa.escalaDias.includes(dia)) return 0;
                
                // INTEGRAL - Precisa isolamento completo
                if (servico.turno === 'integral') {
                    // Verificar dia anterior
                    if (dia > 1) {
                        if (pessoa.escalaDias.includes(dia - 1)) return 0; // Tem escala normal antes
                        if (this.verificarTrabalhouDia(pessoa, dia - 1)) return 0; // Trabalhou antes
                    }
                    // Verificar dia posterior
                    if (dia < 30) {
                        if (pessoa.escalaDias.includes(dia + 1)) return 0; // Tem escala normal depois
                        if (this.verificarTrabalhouDia(pessoa, dia + 1)) return 0; // Vai trabalhar depois
                    }
                }
                
                // MANHÃ - Não pode após escala normal ou noite
                if (servico.turno === 'manha' && dia > 1) {
                    if (pessoa.escalaDias.includes(dia - 1)) return 0; // Trabalhou escala normal ontem
                    if (this.verificarTrabalhouTurno(pessoa, dia - 1, 'noite')) {
                        if (!pessoa.excecaoRegras) return 0; // Fez noite ontem
                    }
                }
                
                // NOITE - Não pode antes de escala normal
                if (servico.turno === 'noite' && dia < 30) {
                    if (pessoa.escalaDias.includes(dia + 1)) return 0; // Tem escala normal amanhã
                }
            }
            
            // CÁLCULO DE SCORE PARA PRIORIZAÇÃO
            
            // Para serviço NOTURNO - distribuição equilibrada especial
            if (servico.turno === 'noite') {
                const servicosNoturnos = pessoa.distribuicaoTurnos?.noite || 0;
                const totalServicos = pessoa.servicosEscalados || 0;
                
                // Priorizar quem tem menos noturnos
                score = 100 - (servicosNoturnos * 25);
                
                // Bonus se tem entre 3-6 serviços totais
                if (totalServicos >= 3 && totalServicos <= 6) {
                    score += 40;
                } else if (totalServicos > 6 && totalServicos <= 9) {
                    score += 20;
                }
                
                // Penalidade se já fez muitos noturnos
                if (servicosNoturnos >= 3) {
                    score -= (servicosNoturnos - 2) * 20;
                }
                
                // Bonus para motoristas (se necessário)
                if (servico.requerMotorista && pessoa.ehMotorista) {
                    score += 35;
                }
            } else {
                // Para outros turnos, usar cálculo padrão
                
                // Distribuição de turnos
                const distribuicao = this.calcularDistribuicaoTurnos(pessoa);
                const percentualTurno = distribuicao[servico.turno] / Math.max(1, distribuicao.total);
                
                if (percentualTurno < 0.25) score += 25;
                else if (percentualTurno > 0.5) score -= 20;
                
                // Considerar carga atual
                const percentualUso = (pessoa.pontosServico || 0) / pessoa.limiteServicos;
                
                if (percentualUso < 0.3) score += 40;
                else if (percentualUso < 0.5) score += 20;
                else if (percentualUso < 0.7) score += 10;
                else if (percentualUso > 0.8) score -= 30;
                else if (percentualUso > 0.9) score -= 50;
                
                // Penalidade para trabalho fora da escala
                const escalaBase = this.detectarEscalaBase(pessoa);
                if (escalaBase && !pessoa.escalaDias.includes(dia)) {
                    score -= 15; // Reduzido para não penalizar tanto
                }
                
                // Bonus para motoristas
                if (servico.requerMotorista && pessoa.ehMotorista) {
                    score += 35;
                }
            }
            
            return Math.max(0, score);
        }
        
        // Nova função para verificar se pode alocar pessoa
        podeAlocarPessoa(pessoa, servico, dia) {
            // Esta função faz uma verificação completa e rigorosa
            
            // 1. Verificações básicas
            if (pessoa.diasExclusao?.includes(dia)) return false;
            if (pessoa.turnosProibidos?.includes(servico.turno)) return false;
            if (servico.requerMotorista && !pessoa.ehMotorista) return false;
            
            // 2. Verificar pontos
            const pontosNecessarios = servico.turno === 'integral' ? 2 : 1;
            if ((pessoa.pontosServico || 0) + pontosNecessarios > pessoa.limiteServicos) return false;
            
            // 3. Verificar se já está escalado no dia
            if (this.pessoaOcupadaNoDia(pessoa, dia)) return false;
            
            // 4. Regras de expediente
            const data = new Date(this.mesAnoGlobal?.ano || 2024, (this.mesAnoGlobal?.mes || 1) - 1, dia);
            const diaSemana = data.getDay();
            
            if (pessoa.expedienteSegASex) {
                if (servico.turno === 'noite') return false;
                if (diaSemana >= 1 && diaSemana <= 5) {
                    if (servico.turno === 'manha' || servico.turno === 'integral') return false;
                }
                return true; // Expediente tem regras mais simples
            }
            
            // 5. Para pessoas com escala normal - verificações rigorosas
            if (pessoa.escalaDias && pessoa.escalaDias.length > 0) {
                // Não pode no próprio dia de escala
                if (pessoa.escalaDias.includes(dia)) return false;
                
                // INTEGRAL - isolamento total
                if (servico.turno === 'integral') {
                    // Verificar 1 dia antes
                    if (dia > 1 && pessoa.escalaDias.includes(dia - 1)) return false;
                    // Verificar 1 dia depois
                    if (dia < 30 && pessoa.escalaDias.includes(dia + 1)) return false;
                    // Verificar se trabalhou ontem em extra
                    if (dia > 1 && this.verificarTrabalhouDia(pessoa, dia - 1)) return false;
                    // Verificar se vai trabalhar amanhã em extra
                    if (dia < 30 && this.verificarTrabalhouDia(pessoa, dia + 1)) return false;
                }
                
                // MANHÃ após escala normal ou noite
                if (servico.turno === 'manha' && dia > 1) {
                    if (pessoa.escalaDias.includes(dia - 1)) return false;
                    if (this.verificarTrabalhouTurno(pessoa, dia - 1, 'noite')) {
                        if (!pessoa.excecaoRegras) return false;
                    }
                }
                
                // NOITE antes de escala normal
                if (servico.turno === 'noite' && dia < 30) {
                    if (pessoa.escalaDias.includes(dia + 1)) return false;
                }
            }
            
            return true;
        }
        
        // Atualizar alocarPessoasParaServico para usar a nova validação
        async alocarPessoasParaServico(servico, dia, matrizCompatibilidade) {
            if (!this.escala[dia]) this.escala[dia] = {};
            
            const pessoasDisponiveis = this.efetivo
                .filter(p => this.podeAlocarPessoa(p, servico, dia))
                .map(p => ({
                    pessoa: p,
                    compatibilidade: this.calcularCompatibilidade(p, servico, dia)
                }))
                .filter(item => item.compatibilidade > 0)
                .sort((a, b) => b.compatibilidade - a.compatibilidade);
            
            const pessoasAlocadas = [];
            
            for (let i = 0; i < servico.limitePessoas && i < pessoasDisponiveis.length; i++) {
                const { pessoa } = pessoasDisponiveis[i];
                
                // Validação final antes de alocar
                if (this.podeAlocarPessoa(pessoa, servico, dia)) {
                    pessoasAlocadas.push(pessoa);
                    this.registrarAlocacao(pessoa, servico, dia);
                } else {
                    console.log(`⚠️ Falha na validação final para ${pessoa.nome} no dia ${dia}`);
                }
            }
            
            this.escala[dia][servico.id] = {
                ...servico,
                pessoas: pessoasAlocadas,
                descoberto: pessoasAlocadas.length < servico.limitePessoas
            };
            
            if (pessoasAlocadas.length < servico.limitePessoas) {
                console.log(`📍 Dia ${dia} - ${servico.nome}: ${pessoasAlocadas.length}/${servico.limitePessoas} pessoas`);
            }
        }
        
        // Nova função auxiliar para detectar escala base
        detectarEscalaBase(pessoa) {
            if (!pessoa.escalaDias || pessoa.escalaDias.length === 0) return null;
            
            const primeiroDia = Math.min(...pessoa.escalaDias);
            if (primeiroDia >= 1 && primeiroDia <= 4) {
                return primeiroDia;
            }
            return null;
        }
        
        // Nova função para verificar se trabalhou em turno específico
        verificarTrabalhouTurno(pessoa, dia, turno) {
            if (!this.escala[dia]) return false;
            
            return Object.values(this.escala[dia]).some(servico => 
                servico.turno === turno && 
                servico.pessoas?.some(p => p.id === pessoa.id)
            );
        }
        
        // Nova função para calcular distribuição de turnos
        calcularDistribuicaoTurnos(pessoa) {
            const dist = { manha: 0, tarde: 0, noite: 0, integral: 0, total: 0 };
            
            if (!pessoa.historicoServicos) return dist;
            
            pessoa.historicoServicos.forEach(h => {
                dist[h.turno]++;
                dist.total++;
            });
            
            return dist;
        }
        
        async alocarPessoasParaServico(servico, dia, matrizCompatibilidade) {
            if (!this.escala[dia]) this.escala[dia] = {};
            
            const pessoasDisponiveis = this.efetivo
                .filter(p => !this.pessoaOcupadaNoDia(p, dia))
                .map(p => ({
                    pessoa: p,
                    compatibilidade: matrizCompatibilidade[p.id][servico.id]
                }))
                .filter(item => item.compatibilidade > 0)
                .sort((a, b) => b.compatibilidade - a.compatibilidade);
            
            const pessoasAlocadas = [];
            
            for (let i = 0; i < servico.limitePessoas && i < pessoasDisponiveis.length; i++) {
                const { pessoa } = pessoasDisponiveis[i];
                pessoasAlocadas.push(pessoa);
                this.registrarAlocacao(pessoa, servico, dia);
            }
            
            this.escala[dia][servico.id] = {
                ...servico,
                pessoas: pessoasAlocadas
            };
        }
        
        pessoaOcupadaNoDia(pessoa, dia) {
            if (!this.escala[dia]) return false;
            
            return Object.values(this.escala[dia]).some(servico => 
                servico.pessoas?.some(p => p.id === pessoa.id)
            );
        }
        
        registrarAlocacao(pessoa, servico, dia) {
            // IMPORTANTE: Integral conta como 2 pontos
            const pontosServico = servico.turno === 'integral' ? 2 : 1;
            
            pessoa.servicosEscalados = (pessoa.servicosEscalados || 0) + 1;
            pessoa.pontosServico = (pessoa.pontosServico || 0) + pontosServico;
            
            if (!pessoa.historicoServicos) pessoa.historicoServicos = [];
            pessoa.historicoServicos.push({ 
                dia, 
                servico: servico.id, 
                turno: servico.turno,
                pontos: pontosServico,
                foraEscala: this.verificarForaEscala(pessoa, dia)
            });
            
            // Atualizar estatísticas de distribuição
            if (!pessoa.distribuicaoTurnos) {
                pessoa.distribuicaoTurnos = { manha: 0, tarde: 0, noite: 0, integral: 0 };
            }
            pessoa.distribuicaoTurnos[servico.turno]++;
        }
        
        verificarForaEscala(pessoa, dia) {
            const escalaBase = this.detectarEscalaBase(pessoa);
            return escalaBase && !pessoa.escalaDias.includes(dia);
        }
        
        // Melhorias no algoritmo de detecção de conflitos
        detectarConflitos() {
            this.conflitosDetectados = [];
            
            for (let dia = 1; dia <= 30; dia++) {
                if (!this.escala[dia]) continue;
                
                // Verificar regras de intervalo
                this.verificarRegrasIntervalo(dia);
                
                // Verificar duplicidade
                this.verificarDuplicidade(dia);
                
                // Verificar requisitos não atendidos
                this.verificarRequisitos(dia);
                
                // NOVA: Verificar isolamento de integrais
                this.verificarIsolamentoIntegral(dia);
                
                // NOVA: Verificar dias de exclusão violados
                this.verificarDiasExclusao(dia);
            }
            
            this.metricas.conflitos = this.conflitosDetectados.length;
        }
        
        verificarIsolamentoIntegral(dia) {
            const servicosDia = this.escala[dia] || {};
            
            Object.values(servicosDia).forEach(servico => {
                if (servico.turno === 'integral') {
                    servico.pessoas?.forEach(pessoa => {
                        // Verificar dia anterior
                        if (dia > 1) {
                            const trabalhouOntem = this.verificarTrabalhouDia(pessoa, dia - 1);
                            if (trabalhouOntem) {
                                this.conflitosDetectados.push({
                                    tipo: 'isolamento_integral',
                                    dia,
                                    pessoa: pessoa.id,
                                    descricao: `Integral sem isolamento anterior (trabalhou dia ${dia-1})`
                                });
                            }
                        }
                        
                        // Verificar dia seguinte
                        if (dia < 30) {
                            const trabalhaAmanha = this.verificarTrabalhouDia(pessoa, dia + 1);
                            if (trabalhaAmanha) {
                                this.conflitosDetectados.push({
                                    tipo: 'isolamento_integral',
                                    dia,
                                    pessoa: pessoa.id,
                                    descricao: `Integral sem isolamento posterior (trabalha dia ${dia+1})`
                                });
                            }
                        }
                    });
                }
            });
        }
        
        verificarTrabalhouDia(pessoa, dia) {
            if (!this.escala[dia]) return false;
            
            return Object.values(this.escala[dia]).some(servico =>
                servico.pessoas?.some(p => p.id === pessoa.id)
            );
        }
        
        verificarDiasExclusao(dia) {
            const servicosDia = this.escala[dia] || {};
            
            Object.values(servicosDia).forEach(servico => {
                servico.pessoas?.forEach(pessoa => {
                    if (pessoa.diasExclusao?.includes(dia)) {
                        this.conflitosDetectados.push({
                            tipo: 'dia_exclusao',
                            dia,
                            pessoa: pessoa.id,
                            descricao: `Pessoa escalada em dia bloqueado (${dia})`,
                            critico: true
                        });
                    }
                });
            });
        }
        
        // Análise detalhada de motivos de não escalação
        analisarMotivosNaoEscalado(pessoa, servico, dia) {
            const motivos = [];
            
            // Verificar dias de exclusão (prioridade máxima)
            if (pessoa.diasExclusao?.includes(dia)) {
                motivos.push({
                    tipo: 'exclusao',
                    descricao: `Dia ${dia} está bloqueado para ${pessoa.nome}`,
                    critico: true
                });
            }
            
            // Verificar limite de pontos
            const pontosNecessarios = servico.turno === 'integral' ? 2 : 1;
            const pontosDisponivel = pessoa.limiteServicos - (pessoa.pontosServico || 0);
            if (pontosDisponivel < pontosNecessarios) {
                motivos.push({
                    tipo: 'limite',
                    descricao: `Limite excedido: tem ${pontosDisponivel} pontos, precisa ${pontosNecessarios}`,
                    critico: true
                });
            }
            
            // Verificar turnos proibidos
            if (pessoa.turnosProibidos?.includes(servico.turno)) {
                motivos.push({
                    tipo: 'turno_proibido',
                    descricao: `Turno ${servico.turno} está proibido para ${pessoa.nome}`,
                    critico: true
                });
            }
            
            // Verificar motorista
            if (servico.requerMotorista && !pessoa.ehMotorista) {
                motivos.push({
                    tipo: 'motorista',
                    descricao: 'Serviço requer motorista habilitado',
                    critico: true
                });
            }
            
            // Verificar dia de escala normal
            if (!pessoa.expedienteSegASex && pessoa.escalaDias?.includes(dia)) {
                motivos.push({
                    tipo: 'escala_normal',
                    descricao: 'Dia está na escala normal (não disponível para extras)',
                    critico: false
                });
            }
            
            // Verificar intervalo entre turnos
            if (dia > 1 && servico.turno === 'manha') {
                const trabalhouNoiteOntem = this.verificarTrabalhouTurno(pessoa, dia - 1, 'noite');
                if (trabalhouNoiteOntem && !pessoa.excecaoRegras) {
                    motivos.push({
                        tipo: 'intervalo',
                        descricao: 'Intervalo insuficiente (trabalhou noite ontem)',
                        critico: false
                    });
                }
            }
            
            return motivos;
        }
        
        verificarRegrasIntervalo(dia) {
            if (dia === 1) return;
            
            const servicosHoje = this.escala[dia] || {};
            const servicosOntem = this.escala[dia - 1] || {};
            
            Object.values(servicosHoje).forEach(servicoHoje => {
                servicoHoje.pessoas?.forEach(pessoa => {
                    Object.values(servicosOntem).forEach(servicoOntem => {
                        if (servicoOntem.pessoas?.some(p => p.id === pessoa.id)) {
                            // Verificar violações
                            if (servicoOntem.turno === 'noite' && servicoHoje.turno === 'manha') {
                                if (!pessoa.excecaoRegras) {
                                    this.conflitosDetectados.push({
                                        tipo: 'intervalo',
                                        dia,
                                        pessoa: pessoa.id,
                                        descricao: 'Noite seguida de manhã'
                                    });
                                }
                            }
                        }
                    });
                });
            });
        }
        
        verificarDuplicidade(dia) {
            const pessoasDia = new Set();
            const servicosDia = this.escala[dia] || {};
            
            Object.values(servicosDia).forEach(servico => {
                servico.pessoas?.forEach(pessoa => {
                    if (pessoasDia.has(pessoa.id)) {
                        this.conflitosDetectados.push({
                            tipo: 'duplicidade',
                            dia,
                            pessoa: pessoa.id,
                            descricao: 'Pessoa em múltiplos serviços'
                        });
                    }
                    pessoasDia.add(pessoa.id);
                });
            });
        }
        
        verificarRequisitos(dia) {
            const servicosDia = this.escala[dia] || {};
            
            Object.values(servicosDia).forEach(servico => {
                if (servico.pessoas?.length < servico.limitePessoas) {
                    this.conflitosDetectados.push({
                        tipo: 'cobertura',
                        dia,
                        servico: servico.id,
                        descricao: `Faltam ${servico.limitePessoas - servico.pessoas.length} pessoas`
                    });
                }
                
                if (servico.requerMotorista) {
                    const temMotorista = servico.pessoas?.some(p => p.ehMotorista);
                    if (!temMotorista) {
                        this.conflitosDetectados.push({
                            tipo: 'motorista',
                            dia,
                            servico: servico.id,
                            descricao: 'Serviço requer motorista'
                        });
                    }
                }
            });
        }
        
        selecionarConflitoMaisCritico() {
            if (this.conflitosDetectados.length === 0) return null;
            
            // Priorizar por tipo
            const prioridades = {
                'cobertura': 1,
                'motorista': 2,
                'intervalo': 3,
                'duplicidade': 4
            };
            
            return this.conflitosDetectados.sort((a, b) => 
                prioridades[a.tipo] - prioridades[b.tipo]
            )[0];
        }
        
        async tentarTroca(conflito) {
            // Implementar lógica de troca inteligente
            // Buscar candidatos para troca
            const candidatos = this.buscarCandidatosTroca(conflito);
            
            for (const candidato of candidatos) {
                if (await this.validarTroca(conflito, candidato)) {
