    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    <script>
    // =====================================
    // SISTEMA DE OTIMIZAÇÃO INTELIGENTE 2.0
    // =====================================
    
    class SistemaEscalasInteligente {
        constructor() {
            this.efetivo = [];
            this.servicos = [];
            this.escala = {};
            this.configuracao = {
                nivelOtimizacao: 'advanced',
                estrategiaBalanceamento: 'adaptive',
                toleranciaConflitos: 20,
                usarIA: true,
                remanejamentoAutomatico: true,
                previsaoProblemas: true
            };
            this.metricas = {
                eficiencia: 0,
                cobertura: 0,
                balanceamento: 0,
                conflitos: 0,
                otimizacoes: 0
            };
            this.historicoOtimizacoes = [];
            this.sugestoesIA = [];
            this.conflitosDetectados = [];
        }
        
        // =====================================
        // ALGORITMO DE OTIMIZAÇÃO PRINCIPAL
        // =====================================
        
        async otimizarEscalaCompleta() {
            mostrarToast('Iniciando otimização inteligente...', 'info');
            atualizarProgressBar(0);
            
            // Fase 1: Análise inicial
            atualizarStatusOtimizacao('Analisando dados...', 'active');
            await this.analisarDados();
            atualizarProgressBar(20);
            
            // Fase 2: Distribuição inicial otimizada
            atualizarStatusOtimizacao('Distribuindo serviços...', 'active');
            await this.distribuirServicosOtimizado();
            atualizarProgressBar(40);
            
            // Fase 3: Detecção de conflitos
            atualizarStatusOtimizacao('Detectando conflitos...', 'active');
            this.detectarConflitos();
            atualizarProgressBar(50);
            
            // Fase 4: Remanejamento inteligente
            if (this.configuracao.remanejamentoAutomatico) {
                atualizarStatusOtimizacao('Remanejando pessoas...', 'active');
                await this.remanejarInteligente();
                atualizarProgressBar(70);
            }
            
            // Fase 5: Balanceamento de carga
            atualizarStatusOtimizacao('Balanceando carga...', 'active');
            await this.balancearCarga();
            atualizarProgressBar(85);
            
            // Fase 6: Otimizações finais com IA
            if (this.configuracao.usarIA) {
                atualizarStatusOtimizacao('Aplicando IA...', 'active');
                await this.aplicarOtimizacoesIA();
            }
            atualizarProgressBar(100);
            
            // Calcular métricas finais
            this.calcularMetricas();
            this.gerarSugestoesIA();
            
            atualizarStatusOtimizacao('Otimização completa!', 'active');
            mostrarToast('Otimização concluída com sucesso!', 'success');
            
            return this.escala;
        }
        
        // =====================================
        // ANÁLISE INTELIGENTE DE DADOS
        // =====================================
        
        async analisarDados() {
            // Análise de padrões de disponibilidade
            this.padroes = {
                disponibilidadePorTurno: {},
                cargaMediaPorPessoa: 0,
                servicosCriticos: [],
                pessoasChave: []
            };
            
            // Analisar disponibilidade por turno
            ['manha', 'tarde', 'noite', 'integral'].forEach(turno => {
                this.padroes.disponibilidadePorTurno[turno] = this.efetivo.filter(p => 
                    !p.turnosProibidos?.includes(turno)
                ).length;
            });
            
            // Identificar serviços críticos (poucos disponíveis)
            this.servicos.forEach(servico => {
                const disponiveis = this.contarDisponiveis(servico);
                if (disponiveis < servico.limitePessoas * 1.5) {
                    this.padroes.servicosCriticos.push(servico);
                }
            });
            
            // Identificar pessoas-chave (alta flexibilidade)
            this.efetivo.forEach(pessoa => {
                const flexibilidade = this.calcularFlexibilidade(pessoa);
                if (flexibilidade > 0.7) {
                    this.padroes.pessoasChave.push(pessoa);
                }
            });
            
            // Calcular carga média necessária
            const totalServicos = this.servicos.reduce((acc, s) => 
                acc + (s.limitePessoas * s.diasDisponiveis.length), 0
            );
            this.padroes.cargaMediaPorPessoa = totalServicos / this.efetivo.length;
            
            return this.padroes;
        }
        
        // Algoritmo otimizado seguindo estratégia manual
        async distribuirServicosOtimizado() {
            const diasNoMes = 30;
            
            console.log('🔄 Iniciando distribuição estratégica (Integral → Noturno → Demais)');
            
            // Identificar pessoas com mais liberdade (sem restrições)
            this.identificarPessoasFlexiveis();
            
            // FASE 1: INTEGRAIS PRIMEIRO (mais restritivos)
            console.log('📍 Fase 1: Alocando serviços INTEGRAIS');
            await this.alocarServicosPorTurno('integral', diasNoMes);
            
            // FASE 2: NOTURNOS (distribuição equilibrada)
            console.log('🌙 Fase 2: Distribuindo serviços NOTURNOS equilibradamente');
            await this.alocarNoturnos(diasNoMes);
            
            // FASE 3: MANHÃ (respeitando restrições)
            console.log('🌅 Fase 3: Alocando serviços de MANHÃ');
            await this.alocarServicosPorTurno('manha', diasNoMes);
            
            // FASE 4: TARDE (complementando escalas)
            console.log('☀️ Fase 4: Complementando com serviços de TARDE');
            await this.alocarServicosPorTurno('tarde', diasNoMes);
            
            // FASE 5: Tentar realocar descobertos usando pessoas flexíveis
            console.log('🔧 Fase 5: Usando pessoas flexíveis para cobrir descobertos');
            await this.usarPessoasFlexiveisParaDescobertos();
            
            // FASE 6: Balanceamento final
            console.log('⚖️ Fase 6: Balanceamento final');
            await this.balancearCarga();
            
            console.log('✅ Distribuição completa!');
            
            return this.escala;
        }
        
        identificarPessoasFlexiveis() {
            // Identificar pessoas como Valter que têm mais liberdade
            this.pessoasFlexiveis = this.efetivo.filter(pessoa => {
                const temRestricoes = (pessoa.turnosProibidos?.length || 0) > 0 ||
                                     (pessoa.diasExclusao?.length || 0) > 5 ||
                                     pessoa.expedienteSegASex;
                
                const ehFlexivel = !temRestricoes && 
                                  pessoa.limiteServicos >= 10 &&
                                  !pessoa.expedienteSegASex;
                
                if (ehFlexivel) {
                    console.log(`✅ ${pessoa.nome} identificado como FLEXÍVEL (tipo Valter)`);
                }
                
                return ehFlexivel;
            });
            
            // Ordenar pessoas por flexibilidade
            this.efetivo.forEach(pessoa => {
                pessoa.scoreFlexibilidade = this.calcularFlexibilidade(pessoa);
            });
        }
        
        calcularFlexibilidade(pessoa) {
            let score = 100;
            
            // Penalizar restrições
            score -= (pessoa.turnosProibidos?.length || 0) * 20;
            score -= (pessoa.diasExclusao?.length || 0) * 2;
            
            // Penalizar expediente (muito restritivo)
            if (pessoa.expedienteSegASex) score -= 40;
            
            // Bonificar alta disponibilidade
            score += (pessoa.limiteServicos / 15) * 20;
            
            // Bonificar motoristas
            if (pessoa.ehMotorista) score += 15;
            
            // Bonificar exceção às regras
            if (pessoa.excecaoRegras) score += 25;
            
            // Pessoas sem escala fixa são mais flexíveis
            if (!pessoa.escalaDias || pessoa.escalaDias.length === 0) {
                score += 30;
            }
            
            return Math.max(0, Math.min(150, score));
        }
        
        async alocarServicosPorTurno(turno, diasNoMes) {
            for (let dia = 1; dia <= diasNoMes; dia++) {
                if (!this.escala[dia]) this.escala[dia] = {};
                
                const servicosDia = this.servicos.filter(s => 
                    s.turno === turno && s.diasDisponiveis?.includes(dia)
                );
                
                for (const servico of servicosDia) {
                    await this.alocarPessoasParaServico(servico, dia);
                }
            }
        }
        
        async alocarNoturnos(diasNoMes) {
            // Coletar todos os serviços noturnos do mês
            const todosNoturnos = [];
            
            for (let dia = 1; dia <= diasNoMes; dia++) {
                const servicosNoturnosDia = this.servicos.filter(s => 
                    s.turno === 'noite' && s.diasDisponiveis?.includes(dia)
                );
                
                servicosNoturnosDia.forEach(servico => {
                    todosNoturnos.push({ servico, dia });
                });
            }
            
            // Criar pool de pessoas disponíveis para noturno
            const poolNoturno = this.efetivo.filter(pessoa => {
                return !pessoa.turnosProibidos?.includes('noite') &&
                       !pessoa.expedienteSegASex &&
                       pessoa.servicosEscalados >= 3; // Só entra no pool após 3 serviços
            });
            
            // Adicionar pessoas flexíveis mesmo com menos de 3 serviços
            this.pessoasFlexiveis?.forEach(pessoa => {
                if (!pessoa.turnosProibidos?.includes('noite') && 
                    !poolNoturno.includes(pessoa)) {
                    poolNoturno.push(pessoa);
                    console.log(`➕ ${pessoa.nome} adicionado ao pool noturno (flexível)`);
                }
            });
            
            // Distribuir noturnos equilibradamente
            let indiceRotacao = 0;
            
            for (const { servico, dia } of todosNoturnos) {
                if (!this.escala[dia]) this.escala[dia] = {};
                
                const pessoasNecessarias = servico.limitePessoas;
                const pessoasAlocadas = [];
                
                // Tentar alocar usando rotação equilibrada
                for (let i = 0; i < pessoasNecessarias; i++) {
                    let tentativas = 0;
                    let pessoaAlocada = false;
                    
                    while (!pessoaAlocada && tentativas < poolNoturno.length) {
                        const pessoa = poolNoturno[indiceRotacao % poolNoturno.length];
                        indiceRotacao++;
                        tentativas++;
                        
                        if (this.podeAlocarPessoa(pessoa, servico, dia)) {
                            pessoasAlocadas.push(pessoa);
                            this.registrarAlocacao(pessoa, servico, dia);
                            pessoaAlocada = true;
                            console.log(`🌙 Dia ${dia}: ${pessoa.nome} → ${servico.nome} (rotação)`);
                        }
                    }
                    
                    // Se não conseguiu com rotação, tentar pessoas flexíveis
                    if (!pessoaAlocada) {
                        const pessoaFlexivel = this.pessoasFlexiveis?.find(p => 
                            this.podeAlocarPessoa(p, servico, dia)
                        );
                        
                        if (pessoaFlexivel) {
                            pessoasAlocadas.push(pessoaFlexivel);
                            this.registrarAlocacao(pessoaFlexivel, servico, dia);
                            console.log(`🌟 Dia ${dia}: ${pessoaFlexivel.nome} → ${servico.nome} (flexível)`);
                        }
                    }
                }
                
                this.escala[dia][servico.id] = {
                    ...servico,
                    pessoas: pessoasAlocadas,
                    descoberto: pessoasAlocadas.length < pessoasNecessarias
                };
            }
        }
        
        async alocarPessoasParaServico(servico, dia) {
            // Verificação de segurança
            if (!servico || !servico.id) {
                console.error('Serviço inválido:', servico);
                return;
            }
            
            if (!this.escala[dia]) {
                this.escala[dia] = {};
            }
            
            // Filtrar candidatos com verificação de segurança
            let candidatos = [];
            
            try {
                candidatos = this.efetivo
                    .filter(p => {
                        if (!p || !p.id) return false;
                        return this.podeAlocarPessoa(p, servico, dia);
                    })
                    .sort((a, b) => {
                        // Verificação de segurança para scoreFlexibilidade
                        const scoreFlexA = a.scoreFlexibilidade || 0;
                        const scoreFlexB = b.scoreFlexibilidade || 0;
                        
                        // Para integral, priorizar pessoas flexíveis
                        if (servico.turno === 'integral') {
                            return scoreFlexB - scoreFlexA;
                        }
                        
                        // Para outros, usar cálculo normal mas considerando flexibilidade
                        try {
                            const scoreA = this.calcularCompatibilidade(a, servico, dia) + scoreFlexA / 10;
                            const scoreB = this.calcularCompatibilidade(b, servico, dia) + scoreFlexB / 10;
                            return scoreB - scoreA;
                        } catch (err) {
                            console.error('Erro ao calcular compatibilidade:', err);
                            return 0;
                        }
                    });
            } catch (err) {
                console.error('Erro ao filtrar candidatos:', err);
                candidatos = [];
            }
            
            const pessoasAlocadas = [];
            const limitePessoas = servico.limitePessoas || 1;
            
            for (let i = 0; i < limitePessoas && i < candidatos.length; i++) {
                const pessoa = candidatos[i];
                
                // Verificação final de segurança
                if (!pessoa || !pessoa.id) {
                    console.error('Pessoa inválida no índice', i);
                    continue;
                }
                
                pessoasAlocadas.push(pessoa);
                this.registrarAlocacao(pessoa, servico, dia);
                
                // CORREÇÃO: Verificar se é pessoa flexível usando comparação de ID
                const ehFlexivel = this.pessoasFlexiveis && 
                                  Array.isArray(this.pessoasFlexiveis) &&
                                  this.pessoasFlexiveis.some(p => p && p.id === pessoa.id);
                
                if (ehFlexivel) {
                    console.log(`🌟 Dia ${dia}: ${pessoa.nome} (FLEXÍVEL) → ${servico.nome}`);
                } else {
                    console.log(`✓ Dia ${dia}: ${pessoa.nome} → ${servico.nome}`);
                }
            }
            
            // Salvar no escala com verificação
            this.escala[dia][servico.id] = {
                ...servico,
                pessoas: pessoasAlocadas,
                descoberto: pessoasAlocadas.length < limitePessoas
            };
            
            if (pessoasAlocadas.length < limitePessoas) {
                console.log(`⚠️ Dia ${dia} - ${servico.nome}: falta ${limitePessoas - pessoasAlocadas.length} pessoa(s)`);
            }
        }
        
        // Corrigir também a função podeAlocarPessoa para ser mais robusta
        podeAlocarPessoa(pessoa, servico, dia) {
            // Verificações de segurança
            if (!pessoa || !servico) return false;
            
            try {
                // 1. Verificações básicas
                if (pessoa.diasExclusao?.includes(dia)) return false;
                if (pessoa.turnosProibidos?.includes(servico.turno)) return false;
                if (servico.requerMotorista && !pessoa.ehMotorista) return false;
                
                // 2. Verificar pontos
                const pontosNecessarios = servico.turno === 'integral' ? 2 : 1;
                if ((pessoa.pontosServico || 0) + pontosNecessarios > pessoa.limiteServicos) return false;
                
                // 3. Verificar se já está escalado no dia
                if (this.pessoaOcupadaNoDia(pessoa, dia)) return false;
                
                // 4. Regras de expediente
                const data = new Date(this.mesAnoGlobal?.ano || 2024, (this.mesAnoGlobal?.mes || 1) - 1, dia);
                const diaSemana = data.getDay();
                
                if (pessoa.expedienteSegASex) {
                    if (servico.turno === 'noite') return false;
                    if (diaSemana >= 1 && diaSemana <= 5) {
                        if (servico.turno === 'manha' || servico.turno === 'integral') return false;
                    }
                    return true;
                }
                
                // 5. Para pessoas com escala normal - verificações rigorosas
                if (pessoa.escalaDias && pessoa.escalaDias.length > 0) {
                    if (pessoa.escalaDias.includes(dia)) return false;
                    
                    // INTEGRAL - isolamento total
                    if (servico.turno === 'integral') {
                        if (dia > 1 && pessoa.escalaDias.includes(dia - 1)) return false;
                        if (dia < 30 && pessoa.escalaDias.includes(dia + 1)) return false;
                        if (dia > 1 && this.verificarTrabalhouDia(pessoa, dia - 1)) return false;
                        if (dia < 30 && this.verificarTrabalhouDia(pessoa, dia + 1)) return false;
                    }
                    
                    // MANHÃ após escala normal ou noite
                    if (servico.turno === 'manha' && dia > 1) {
                        if (pessoa.escalaDias.includes(dia - 1)) return false;
                        if (this.verificarTrabalhouTurno(pessoa, dia - 1, 'noite')) {
                            if (!pessoa.excecaoRegras) return false;
                        }
                    }
                    
                    // NOITE antes de escala normal
                    if (servico.turno === 'noite' && dia < 30) {
                        if (pessoa.escalaDias.includes(dia + 1)) return false;
                    }
                }
                
                return true;
                
            } catch (err) {
                console.error('Erro em podeAlocarPessoa:', err);
                return false;
            }
        }
        
        // Corrigir pessoaOcupadaNoDia para ser mais segura
        pessoaOcupadaNoDia(pessoa, dia) {
            if (!pessoa || !pessoa.id || !this.escala[dia]) return false;
            
            try {
                return Object.values(this.escala[dia]).some(servico => 
                    servico && servico.pessoas && 
                    Array.isArray(servico.pessoas) &&
                    servico.pessoas.some(p => p && p.id === pessoa.id)
                );
            } catch (err) {
                console.error('Erro em pessoaOcupadaNoDia:', err);
                return false;
            }
        }
        
        // Corrigir verificarTrabalhouDia
        verificarTrabalhouDia(pessoa, dia) {
            if (!pessoa || !pessoa.id || !this.escala[dia]) return false;
            
            try {
                return Object.values(this.escala[dia]).some(servico =>
                    servico && servico.pessoas && 
                    Array.isArray(servico.pessoas) &&
                    servico.pessoas.some(p => p && p.id === pessoa.id)
                );
            } catch (err) {
                console.error('Erro em verificarTrabalhouDia:', err);
                return false;
            }
        }
        
        // Corrigir verificarTrabalhouTurno
        verificarTrabalhouTurno(pessoa, dia, turno) {
            if (!pessoa || !pessoa.id || !this.escala[dia]) return false;
            
            try {
                return Object.values(this.escala[dia]).some(servico =>
                    servico && servico.turno === turno && 
                    servico.pessoas && Array.isArray(servico.pessoas) &&
                    servico.pessoas.some(p => p && p.id === pessoa.id)
                );
            } catch (err) {
                console.error('Erro em verificarTrabalhouTurno:', err);
                return false;
            }
        }
        
        // Adicionar reset de escala antes de gerar nova
        async otimizarEscalaCompleta() {
            mostrarToast('Iniciando otimização inteligente...', 'info');
            atualizarProgressBar(0);
            
            // IMPORTANTE: Resetar escala e estado
            this.escala = {};
            this.conflitosDetectados = [];
            this.sugestoesGeradas = [];
            
            // Resetar contadores das pessoas
            this.efetivo.forEach(pessoa => {
                pessoa.servicosEscalados = 0;
                pessoa.pontosServico = 0;
                pessoa.historicoServicos = [];
                pessoa.distribuicaoTurnos = { manha: 0, tarde: 0, noite: 0, integral: 0 };
            });
            
            // Verificar se temos dados válidos
            if (!this.efetivo || this.efetivo.length === 0) {
                mostrarToast('Adicione pessoas ao efetivo primeiro!', 'error');
                return;
            }
            
            if (!this.servicos || this.servicos.length === 0) {
                mostrarToast('Adicione serviços primeiro!', 'error');
                return;
            }
            
            // Configurar mês/ano global
            const mesAnoInput = document.getElementById('mes-ano');
            if (mesAnoInput && mesAnoInput.value) {
                const [ano, mes] = mesAnoInput.value.split('-').map(Number);
                this.mesAnoGlobal = { ano, mes, diasNoMes: new Date(ano, mes, 0).getDate() };
            } else {
                const hoje = new Date();
                this.mesAnoGlobal = { 
                    ano: hoje.getFullYear(), 
                    mes: hoje.getMonth() + 1,
                    diasNoMes: new Date(hoje.getFullYear(), hoje.getMonth() + 1, 0).getDate()
                };
            }
            
            try {
                // Fase 1: Análise inicial
                atualizarStatusOtimizacao('Analisando dados...', 'active');
                await this.analisarDados();
                atualizarProgressBar(20);
                
                // Fase 2: Distribuição otimizada
                atualizarStatusOtimizacao('Distribuindo serviços...', 'active');
                await this.distribuirServicosOtimizado();
                atualizarProgressBar(60);
                
                // Fase 3: Detecção de conflitos
                atualizarStatusOtimizacao('Detectando conflitos...', 'active');
                this.detectarConflitos();
                atualizarProgressBar(70);
                
                // Fase 4: Balanceamento
                atualizarStatusOtimizacao('Balanceando carga...', 'active');
                await this.balancearCarga();
                atualizarProgressBar(90);
                
                // Fase 5: Calcular métricas
                this.calcularMetricas();
                this.gerarSugestoesIA();
                atualizarProgressBar(100);
                
                atualizarStatusOtimizacao('Otimização completa!', 'active');
                mostrarToast('Otimização concluída com sucesso!', 'success');
                
            } catch (err) {
                console.error('Erro durante otimização:', err);
                mostrarToast('Erro durante otimização: ' + err.message, 'error');
                atualizarStatusOtimizacao('Erro na otimização', 'error');
            }
            
            return this.escala;
        }
        
        async usarPessoasFlexiveisParaDescobertos() {
            let melhorias = 0;
            
            // Buscar serviços descobertos
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.escala[dia] || {};
                
                for (const servicoId in servicosDia) {
                    const servico = servicosDia[servicoId];
                    
                    while (servico.pessoas.length < servico.limitePessoas) {
                        // Tentar usar pessoa flexível primeiro
                        const pessoaFlexivel = this.pessoasFlexiveis?.find(p => 
                            this.podeAlocarPessoa(p, servico, dia)
                        );
                        
                        if (pessoaFlexivel) {
                            servico.pessoas.push(pessoaFlexivel);
                            this.registrarAlocacao(pessoaFlexivel, servico, dia);
                            melhorias++;
                            console.log(`🌟 FLEXÍVEL: ${pessoaFlexivel.nome} cobrindo ${servico.nome} dia ${dia}`);
                        } else {
                            // Se não tem flexível, tentar pessoa com exceção
                            const pessoaExcecao = this.efetivo.find(p => 
                                p.excecaoRegras && 
                                !this.pessoaOcupadaNoDia(p, dia) &&
                                (p.pontosServico || 0) < p.limiteServicos
                            );
                            
                            if (pessoaExcecao) {
                                servico.pessoas.push(pessoaExcecao);
                                this.registrarAlocacao(pessoaExcecao, servico, dia);
                                melhorias++;
                                console.log(`⚠️ EXCEÇÃO: ${pessoaExcecao.nome} cobrindo ${servico.nome} dia ${dia}`);
                            } else {
                                break; // Não tem mais opções
                            }
                        }
                    }
                }
            }
            
            if (melhorias > 0) {
                console.log(`✅ ${melhorias} posições cobertas usando pessoas flexíveis/exceção`);
            }
            
            return melhorias;
        }
        
        encontrarMelhorPessoaV2(servico, dia, jaEscaladosDia, diaSemana) {
            // Filtrar candidatos válidos
            const candidatos = this.efetivo.filter(pessoa => {
                // Verificação de exclusão absoluta
                if (jaEscaladosDia.has(pessoa.id)) return false;
                if (pessoa.diasExclusao?.includes(dia)) return false;
                
                // Verificação de pontos (INTEGRAL = 2)
                const pontosNecessarios = servico.turno === 'integral' ? 2 : 1;
                if ((pessoa.pontosServico || 0) + pontosNecessarios > pessoa.limiteServicos) return false;
                
                // Verificações básicas
                if (pessoa.turnosProibidos?.includes(servico.turno)) return false;
                if (servico.requerMotorista && !pessoa.ehMotorista) return false;
                
                // Regras de expediente
                if (pessoa.expedienteSegASex) {
                    if (servico.turno === 'noite') return false;
                    if (diaSemana >= 1 && diaSemana <= 5 && 
                        (servico.turno === 'manha' || servico.turno === 'integral')) return false;
                }
                
                // CORREÇÃO CRÍTICA: Verificar escala normal e isolamento
                if (!pessoa.expedienteSegASex && pessoa.escalaDias && pessoa.escalaDias.length > 0) {
                    // Se está na escala normal hoje, não pode fazer serviço extra
                    if (pessoa.escalaDias.includes(dia)) {
                        return false;
                    }
                    
                    // VERIFICAÇÃO DE INTEGRAL - ISOLAMENTO COMPLETO
                    if (servico.turno === 'integral') {
                        // Não pode fazer integral se trabalha na escala normal dia antes
                        if (pessoa.escalaDias.includes(dia - 1)) {
                            return false;
                        }
                        // Não pode fazer integral se trabalha na escala normal dia depois
                        if (pessoa.escalaDias.includes(dia + 1)) {
                            return false;
                        }
                        // Verificar se já trabalhou em serviço extra dia antes
                        if (dia > 1 && this.verificarTrabalhouDia(pessoa, dia - 1)) {
                            return false;
                        }
                        // Verificar se já tem serviço extra dia depois
                        if (dia < 30 && this.verificarTrabalhouDia(pessoa, dia + 1)) {
                            return false;
                        }
                    }
                    
                    // VERIFICAÇÃO PARA OUTROS TURNOS APÓS ESCALA NORMAL
                    if (dia > 1 && pessoa.escalaDias.includes(dia - 1)) {
                        // Trabalhou na escala normal ontem
                        if (servico.turno === 'manha') {
                            // Não pode fazer manhã após escala normal
                            return false;
                        }
                    }
                    
                    // VERIFICAÇÃO PARA SERVIÇOS ANTES DA ESCALA NORMAL
                    if (pessoa.escalaDias.includes(dia + 1)) {
                        // Vai trabalhar na escala normal amanhã
                        if (servico.turno === 'noite' || servico.turno === 'integral') {
                            // Não pode fazer noite ou integral antes da escala normal
                            return false;
                        }
                    }
                }
                
                // Verificar intervalo mínimo entre serviços extras
                if (dia > 1 && servico.turno === 'manha') {
                    const trabalhouNoiteOntem = this.verificarTrabalhouTurno(pessoa, dia - 1, 'noite');
                    if (trabalhouNoiteOntem && !pessoa.excecaoRegras) return false;
                }
                
                return true;
            });
            
            if (candidatos.length === 0) return null;
            
            // REGRA ESPECIAL PARA NOTURNO: Distribuição equilibrada
            if (servico.turno === 'noite') {
                // Para serviço noturno, priorizar quem tem menos serviços noturnos
                candidatos.forEach(pessoa => {
                    const servicosNoturnos = (pessoa.distribuicaoTurnos?.noite || 0);
                    const totalServicos = pessoa.servicosEscalados || 0;
                    
                    // Score base para distribuição equilibrada
                    let score = 100 - (servicosNoturnos * 20);
                    
                    // Bonus para quem tem poucos serviços no total (mas pelo menos 3)
                    if (totalServicos >= 3 && totalServicos < 6) {
                        score += 30;
                    } else if (totalServicos >= 6) {
                        score += 10;
                    }
                    
                    // Bonus para motoristas (muitos noturnos precisam)
                    if (pessoa.ehMotorista && servico.requerMotorista) {
                        score += 25;
                    }
                    
                    // Penalidade se já fez muito noturno
                    if (servicosNoturnos > 3) {
                        score -= servicosNoturnos * 10;
                    }
                    
                    pessoa.scoreTemp = score;
                });
            } else {
                // Para outros turnos, usar cálculo normal
                candidatos.forEach(pessoa => {
                    pessoa.scoreTemp = this.calcularScorePessoa(pessoa, servico, dia);
                });
            }
            
            candidatos.sort((a, b) => b.scoreTemp - a.scoreTemp);
            
            return candidatos[0];
        }
        
        // Atualizar verificação de conflitos para detectar estes problemas
        verificarRegrasIntervalo(dia) {
            const servicosHoje = this.escala[dia] || {};
            const servicosOntem = dia > 1 ? this.escala[dia - 1] || {} : {};
            const servicosAmanha = dia < 30 ? this.escala[dia + 1] || {} : {};
            
            Object.values(servicosHoje).forEach(servicoHoje => {
                servicoHoje.pessoas?.forEach(pessoa => {
                    // VERIFICAR INTEGRAL - ISOLAMENTO TOTAL
                    if (servicoHoje.turno === 'integral') {
                        // Verificar se pessoa trabalhou ontem (escala normal ou extra)
                        if (dia > 1) {
                            // Verificar escala normal
                            if (pessoa.escalaDias?.includes(dia - 1)) {
                                this.conflitosDetectados.push({
                                    tipo: 'integral_sem_isolamento',
                                    dia,
                                    pessoa: pessoa.id,
                                    descricao: `${pessoa.nome} fez integral dia ${dia} mas tem escala normal dia ${dia-1}`,
                                    critico: true
                                });
                            }
                            // Verificar serviços extras
                            Object.values(servicosOntem).forEach(servicoOntem => {
                                if (servicoOntem.pessoas?.some(p => p.id === pessoa.id)) {
                                    this.conflitosDetectados.push({
                                        tipo: 'integral_sem_isolamento',
                                        dia,
                                        pessoa: pessoa.id,
                                        descricao: `${pessoa.nome} fez integral dia ${dia} mas trabalhou dia ${dia-1}`,
                                        critico: true
                                    });
                                }
                            });
                        }
                        
                        // Verificar se pessoa trabalha amanhã
                        if (dia < 30) {
                            // Verificar escala normal
                            if (pessoa.escalaDias?.includes(dia + 1)) {
                                this.conflitosDetectados.push({
                                    tipo: 'integral_sem_isolamento',
                                    dia,
                                    pessoa: pessoa.id,
                                    descricao: `${pessoa.nome} fez integral dia ${dia} mas tem escala normal dia ${dia+1}`,
                                    critico: true
                                });
                            }
                            // Verificar serviços extras agendados
                            Object.values(servicosAmanha).forEach(servicoAmanha => {
                                if (servicoAmanha.pessoas?.some(p => p.id === pessoa.id)) {
                                    this.conflitosDetectados.push({
                                        tipo: 'integral_sem_isolamento',
                                        dia,
                                        pessoa: pessoa.id,
                                        descricao: `${pessoa.nome} fez integral dia ${dia} mas trabalha dia ${dia+1}`,
                                        critico: true
                                    });
                                }
                            });
                        }
                    }
                    
                    // VERIFICAR MANHÃ APÓS ESCALA NORMAL OU NOITE
                    if (servicoHoje.turno === 'manha' && dia > 1) {
                        // Verificar se trabalhou na escala normal ontem
                        if (pessoa.escalaDias?.includes(dia - 1)) {
                            this.conflitosDetectados.push({
                                tipo: 'manha_apos_escala',
                                dia,
                                pessoa: pessoa.id,
                                descricao: `${pessoa.nome} fez manhã dia ${dia} após escala normal dia ${dia-1}`,
                                critico: true
                            });
                        }
                        
                        // Verificar se fez noite ontem
                        Object.values(servicosOntem).forEach(servicoOntem => {
                            if (servicoOntem.turno === 'noite' && 
                                servicoOntem.pessoas?.some(p => p.id === pessoa.id)) {
                                if (!pessoa.excecaoRegras) {
                                    this.conflitosDetectados.push({
                                        tipo: 'noite_manha',
                                        dia,
                                        pessoa: pessoa.id,
                                        descricao: `${pessoa.nome} fez noite dia ${dia-1} e manhã dia ${dia}`,
                                        critico: true
                                    });
                                }
                            }
                        });
                    }
                    
                    // VERIFICAR NOITE ANTES DE ESCALA NORMAL
                    if (servicoHoje.turno === 'noite' && dia < 30) {
                        if (pessoa.escalaDias?.includes(dia + 1)) {
                            this.conflitosDetectados.push({
                                tipo: 'noite_antes_escala',
                                dia,
                                pessoa: pessoa.id,
                                descricao: `${pessoa.nome} fez noite dia ${dia} mas tem escala normal dia ${dia+1}`,
                                critico: true
                            });
                        }
                    }
                });
            });
        }
        
        calcularScorePessoa(pessoa, servico, dia) {
            let score = 0;
            
            // Base: menos serviços = maior prioridade
            score += (20 - (pessoa.servicosEscalados || 0)) * 10;
            
            // Percentual de uso
            const percentualUso = (pessoa.pontosServico || 0) / pessoa.limiteServicos;
            if (percentualUso < 0.3) score += 50;
            else if (percentualUso < 0.5) score += 30;
            else if (percentualUso < 0.7) score += 15;
            else if (percentualUso > 0.9) score -= 30;
            
            // Bonus para motoristas
            if (servico.requerMotorista && pessoa.ehMotorista) score += 40;
            
            // Distribuição de turnos
            const dist = pessoa.distribuicaoTurnos || {};
            const totalTurnos = Object.values(dist).reduce((a, b) => a + b, 0);
            if (totalTurnos > 0) {
                const percentualTurno = (dist[servico.turno] || 0) / totalTurnos;
                if (percentualTurno < 0.25) score += 20;
                else if (percentualTurno > 0.5) score -= 15;
            }
            
            // Penalidade para fora da escala
            const escalaBase = this.detectarEscalaBase(pessoa);
            if (escalaBase && !pessoa.escalaDias?.includes(dia)) {
                score -= 20;
                // Mas bonus se for turno crítico
                if (servico.turno === 'noite' || servico.turno === 'integral') {
                    score += 10;
                }
            }
            
            // Bonus para exceção em situações críticas
            if (pessoa.excecaoRegras && servico.descoberto) {
                score += 30;
            }
            
            return score;
        }
        
        async tentarRealocacoes() {
            let melhorias = 0;
            
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.escala[dia] || {};
                
                for (const servicoId in servicosDia) {
                    const servico = servicosDia[servicoId];
                    
                    if (servico.descoberto && servico.pessoas.length < servico.limitePessoas) {
                        // Tentar pegar pessoa de outro serviço menos crítico
                        for (const outroId in servicosDia) {
                            if (outroId === servicoId) continue;
                            
                            const outroServico = servicosDia[outroId];
                            
                            // Se outro serviço tem sobra
                            if (outroServico.pessoas?.length > 1) {
                                // Verificar se pode realocar
                                const candidato = outroServico.pessoas.find(p => 
                                    this.podeRealocarV2(p, servico, outroServico)
                                );
                                
                                if (candidato) {
                                    // Fazer realocação
                                    outroServico.pessoas = outroServico.pessoas.filter(p => p.id !== candidato.id);
                                    servico.pessoas.push(candidato);
                                    servico.descoberto = servico.pessoas.length < servico.limitePessoas;
                                    melhorias++;
                                    console.log(`✓ Realocado ${candidato.nome} para ${servico.nome} dia ${dia}`);
                                    break;
                                }
                            }
                        }
                    }
                }
            }
            
            return melhorias;
        }
        
        podeRealocarV2(pessoa, servicoDestino, servicoOrigem) {
            // Verificações básicas
            if (servicoDestino.requerMotorista && !pessoa.ehMotorista) return false;
            if (pessoa.turnosProibidos?.includes(servicoDestino.turno)) return false;
            
            // Evitar conflitos de horário
            if (servicoDestino.turno === 'integral' && servicoOrigem.turno === 'integral') return false;
            
            // Verificar se a realocação melhora a situação
            const criticidadeDestino = servicoDestino.turno === 'noite' || servicoDestino.turno === 'integral' ? 2 : 1;
            const criticidadeOrigem = servicoOrigem.turno === 'noite' || servicoOrigem.turno === 'integral' ? 2 : 1;
            
            return criticidadeDestino >= criticidadeOrigem;
        }
        
        async usarPessoasComExcecao() {
            let melhorias = 0;
            const pessoasComExcecao = this.efetivo.filter(p => p.excecaoRegras);
            
            if (pessoasComExcecao.length === 0) return 0;
            
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.escala[dia] || {};
                
                for (const servicoId in servicosDia) {
                    const servico = servicosDia[servicoId];
                    
                    if (servico.pessoas.length < servico.limitePessoas) {
                        for (const pessoa of pessoasComExcecao) {
                            // Verificar apenas restrições absolutas
                            if (this.pessoaOcupadaNoDia(pessoa, dia)) continue;
                            if (pessoa.diasExclusao?.includes(dia)) continue;
                            
                            const pontosNecessarios = servico.turno === 'integral' ? 2 : 1;
                            if ((pessoa.pontosServico || 0) + pontosNecessarios > pessoa.limiteServicos) continue;
                            
                            if (servico.requerMotorista && !pessoa.ehMotorista) continue;
                            
                            // Alocar com exceção
                            servico.pessoas.push(pessoa);
                            this.registrarAlocacao(pessoa, servico, dia);
                            melhorias++;
                            console.log(`⚠️ EXCEÇÃO: ${pessoa.nome} alocado para ${servico.nome} dia ${dia}`);
                            break;
                        }
                    }
                }
            }
            
            return melhorias;
        }
        
        contarServicosDescobertos() {
            let count = 0;
            
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.escala[dia] || {};
                
                Object.values(servicosDia).forEach(servico => {
                    if (servico.pessoas?.length < servico.limitePessoas) {
                        count += servico.limitePessoas - servico.pessoas.length;
                    }
                });
            }
            
            return count;
        }
        
