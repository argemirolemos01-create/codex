        // Funções auxiliares
        formatarTipoConflito(tipo) {
            const tipos = {
                'intervalo': 'Intervalo insuficiente entre turnos',
                'duplicidade': 'Pessoa em múltiplos serviços',
                'cobertura': 'Serviço sem cobertura completa',
                'motorista': 'Falta motorista habilitado',
                'isolamento_integral': 'Integral sem isolamento',
                'dia_exclusao': 'Pessoa em dia bloqueado'
            };
            return tipos[tipo] || tipo;
        }
        
        analisarProblemasPrincipais() {
            const pessoasSemEscala = this.sistema.efetivo.filter(p => 
                (p.servicosEscalados || 0) === 0
            ).length;
            
            let servicosDescobertos = 0;
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.sistema.escala[dia] || {};
                Object.values(servicosDia).forEach(s => {
                    servicosDescobertos += Math.max(0, s.limitePessoas - (s.pessoas?.length || 0));
                });
            }
            
            const stats = this.sistema.calcularEstatisticasPessoas();
            const desbalanceamento = (stats.desvioPadrao / Math.max(1, stats.media)) * 100;
            
            return {
                pessoasSemEscala,
                servicosDescobertos,
                desbalanceamento
            };
        }
        
        explicarProblemasGerais() {
            const problemas = this.analisarProblemasPrincipais();
            
            let resposta = `📋 **ANÁLISE DE PROBLEMAS GERAIS**\n\n`;
            
            if (problemas.pessoasSemEscala > 0) {
                const pessoas = this.sistema.efetivo.filter(p => 
                    (p.servicosEscalados || 0) === 0
                );
                
                resposta += `**Pessoas sem escala:**\n`;
                pessoas.forEach(p => {
                    resposta += `• ${p.nome}`;
                    if (p.turnosProibidos?.length > 2) {
                        resposta += ` (muitas restrições)`;
                    }
                    resposta += `\n`;
                });
                resposta += `\n`;
            }
            
            return resposta + `Use "sugestões" para ver como resolver.`;
        }
        
        listarServicosDescobertos() {
            let resposta = `🔍 **SERVIÇOS DESCOBERTOS**\n\n`;
            let encontrou = false;
            
            for (let dia = 1; dia <= 30; dia++) {
                const servicosDia = this.sistema.escala[dia] || {};
                
                Object.values(servicosDia).forEach(servico => {
                    const faltando = servico.limitePessoas - (servico.pessoas?.length || 0);
                    if (faltando > 0) {
                        encontrou = true;
                        resposta += `• Dia ${dia} - ${servico.nome} (${servico.turno}): falta ${faltando}\n`;
                    }
                });
            }
            
            if (!encontrou) {
                resposta += `✅ Todos os serviços estão cobertos!`;
            } else {
                resposta += `\n💡 Use "otimizar" para tentar resolver automaticamente.`;
            }
            
            return resposta;
        }
        
        sugerirTrocas() {
            let resposta = `🔄 **SUGESTÕES DE TROCAS**\n\n`;
            
            // Identificar pessoas sobrecarregadas e subutilizadas
            const sobrecarregados = this.sistema.efetivo.filter(p => 
                (p.pontosServico || 0) > p.limiteServicos * 0.8
            );
            
            const subutilizados = this.sistema.efetivo.filter(p => 
                (p.pontosServico || 0) < p.limiteServicos * 0.3
            );
            
            if (sobrecarregados.length > 0 && subutilizados.length > 0) {
                resposta += `**Possíveis trocas benéficas:**\n`;
                
                sobrecarregados.slice(0, 3).forEach(sobre => {
                    const sub = subutilizados[0];
                    if (sub) {
                        resposta += `• Transferir serviços de ${sobre.nome} (${sobre.pontosServico} pts) `;
                        resposta += `para ${sub.nome} (${sub.pontosServico || 0} pts)\n`;
                    }
                });
            } else {
                resposta += `Distribuição está relativamente equilibrada.`;
            }
            
            return resposta;
        }
        
        analisarMotoristas() {
            const motoristas = this.sistema.efetivo.filter(p => p.ehMotorista);
            const servicosMotorista = this.sistema.servicos.filter(s => s.requerMotorista);
            
            let resposta = `🚗 **ANÁLISE DE MOTORISTAS**\n\n`;
            
            resposta += `• Total de motoristas: ${motoristas.length}\n`;
            resposta += `• Serviços que requerem: ${servicosMotorista.length}\n\n`;
            
            resposta += `**Motoristas disponíveis:**\n`;
            motoristas.forEach(m => {
                resposta += `• ${m.nome}: ${m.servicosEscalados || 0} serviços, `;
                resposta += `${m.limiteServicos - (m.pontosServico || 0)} pts livres\n`;
            });
            
            return resposta;
        }
        
        analisarIntegrais() {
            let resposta = `🕐 **ANÁLISE DE PLANTÕES INTEGRAIS**\n\n`;
            
            const servicosIntegrais = this.sistema.servicos.filter(s => s.turno === 'integral');
            
            resposta += `• Total de integrais: ${servicosIntegrais.length}\n`;
            resposta += `• Pontos por integral: 2\n\n`;
            
            let cobertos = 0;
            let descobertos = 0;
            
            servicosIntegrais.forEach(servico => {
                servico.diasDisponiveis?.forEach(dia => {
                    const servicoDia = this.sistema.escala[dia]?.[servico.id];
                    if (servicoDia) {
                        if (servicoDia.pessoas?.length >= servico.limitePessoas) {
                            cobertos++;
                        } else {
                            descobertos++;
                        }
                    }
                });
            });
            
            resposta += `📊 **Cobertura:**\n`;
            resposta += `• Cobertos: ${cobertos}\n`;
            resposta += `• Descobertos: ${descobertos}\n\n`;
            
            if (descobertos > 0) {
                resposta += `⚠️ Integrais precisam isolamento (dia antes e depois livre).`;
            }
            
            return resposta;
        }
        
        analisarNoturnos() {
            let resposta = `🌙 **ANÁLISE DE SERVIÇOS NOTURNOS**\n\n`;
            
            const servicosNoturnos = this.sistema.servicos.filter(s => s.turno === 'noite');
            
            resposta += `• Total de noturnos: ${servicosNoturnos.length}\n\n`;
            
            // Verificar cobertura
            let totalNecessario = 0;
            let totalCoberto = 0;
            
            servicosNoturnos.forEach(servico => {
                servico.diasDisponiveis?.forEach(dia => {
                    totalNecessario += servico.limitePessoas;
                    const servicoDia = this.sistema.escala[dia]?.[servico.id];
                    if (servicoDia) {
                        totalCoberto += servicoDia.pessoas?.length || 0;
                    }
                });
            });
            
            const taxaCobertura = totalNecessario > 0 ? 
                (totalCoberto / totalNecessario * 100).toFixed(0) : 0;
            
            resposta += `📊 **Cobertura noturna:** ${taxaCobertura}%\n\n`;
            
            resposta += `⚠️ **Lembre-se:**\n`;
            resposta += `• Expediente não pode fazer noite\n`;
            resposta += `• Quem faz noite não pode fazer manhã no dia seguinte`;
            
            return resposta;
        }
    }
    
